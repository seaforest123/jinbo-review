.archive-page { min-height: 100vh; margin: -32rpx; padding: 62rpx 30rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #f9f0da; background: radial-gradient(circle at 88% 2%, #53381e, #20140d 39%, #100b08 82%); }
.archive-intro { max-width: 620rpx; padding: 16rpx 8rpx 46rpx; }.archive-kicker,.section-kicker { color: #d8af59; font-size: 18rpx; letter-spacing: 4rpx; }.archive-title { margin-top: 13rpx; font-family: serif; font-size: 58rpx; font-weight: 700; line-height: 1.12; }.archive-lead { max-width: 560rpx; margin-top: 20rpx; color: rgba(255,248,232,.61); font-size: 24rpx; line-height: 1.8; }.archive-reference { max-width: 560rpx; margin-top: 17rpx; color: rgba(255,248,232,.34); font-size: 17rpx; line-height: 1.65; }
.route-exhibit { overflow: hidden; border: 1rpx solid rgba(244,215,123,.18); background: rgba(255,255,255,.025); box-shadow: 0 32rpx 80rpx rgba(0,0,0,.28); }.route-hero { position: relative; height: 430rpx; overflow: hidden; background: #2c1c11; }.route-image { width: 100%; height: 100%; filter: sepia(.2) saturate(.75) brightness(.72); }.route-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13,8,5,.94), rgba(13,8,5,.12) 72%); }.route-copy { position: absolute; right: 32rpx; bottom: 30rpx; left: 32rpx; }.route-status { color: rgba(248,227,170,.64); font-size: 18rpx; letter-spacing: 2rpx; }.route-name { margin-top: 12rpx; font-family: serif; font-size: 40rpx; font-weight: 700; line-height: 1.25; }.route-progress { margin-top: 15rpx; color: rgba(255,248,232,.62); font-size: 21rpx; }.route-progress text { margin-right: 6rpx; color: #f4d77b; font-family: serif; font-size: 38rpx; }
.route-actions { display: grid; padding: 24rpx; grid-template-columns: minmax(0, 1fr) 196rpx; gap: 14rpx; border-top: 1rpx solid rgba(244,215,123,.12); }.route-actions button { min-height: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 0; font-size: 21rpx; }.route-primary { display: flex; align-items: center; justify-content: space-between; color: #26180e; background: linear-gradient(100deg, #d3a643, #f4d987, #bf8126); font-weight: 700; }.route-primary text { font-size: 35rpx; font-weight: 300; }.route-secondary { display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(244,215,123,.28); color: rgba(255,248,232,.72); background: transparent; }
.knowledge-section { padding: 54rpx 24rpx 30rpx; border-top: 1rpx solid rgba(244,215,123,.12); }.section-title { margin-top: 10rpx; font-family: serif; font-size: 42rpx; font-weight: 700; }.section-lead { max-width: 570rpx; margin-top: 14rpx; color: rgba(255,248,232,.53); font-size: 21rpx; line-height: 1.75; }.knowledge-list { margin-top: 32rpx; }.knowledge-card { display: grid; grid-template-columns: 178rpx minmax(0, 1fr); min-height: 178rpx; overflow: hidden; border-top: 1rpx solid rgba(255,255,255,.12); background: rgba(255,255,255,.025); }.knowledge-card:last-child { border-bottom: 1rpx solid rgba(255,255,255,.12); }.card-image { width: 178rpx; height: 178rpx; filter: sepia(.13) saturate(.78) brightness(.82); }.card-copy { min-width: 0; padding: 21rpx 20rpx 20rpx; }.card-index { color: rgba(244,215,123,.5); font-family: serif; font-size: 17rpx; letter-spacing: 3rpx; }.card-title { margin-top: 7rpx; font-family: serif; font-size: 28rpx; font-weight: 700; line-height: 1.3; }.card-description { margin-top: 9rpx; color: rgba(255,248,232,.58); font-size: 19rpx; line-height: 1.6; }.knowledge-source { margin-top: 22rpx; color: rgba(255,248,232,.34); font-size: 17rpx; line-height: 1.65; }
.archive-footer { display: grid; margin-top: 28rpx; grid-template-columns: 1fr 1fr; gap: 12rpx; }.footer-link { display: flex; align-items: center; justify-content: center; min-height: 82rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(244,215,123,.24); border-radius: 0; color: #efcf78; background: rgba(244,215,123,.055); font-size: 21rpx; }.footer-link text { margin-left: 9rpx; font-size: 28rpx; }.footer-link.subtle { border-color: rgba(255,255,255,.1); color: rgba(255,248,232,.52); background: transparent; }
@media (max-width: 360px) { .archive-page { padding-right: 22rpx; padding-left: 22rpx; }.archive-title { font-size: 51rpx; }.route-hero { height: 390rpx; }.route-actions { grid-template-columns: 1fr; }.route-secondary { min-height: 72rpx !important; }.knowledge-section { padding-right: 20rpx; padding-left: 20rpx; }.knowledge-card { grid-template-columns: 148rpx minmax(0, 1fr); min-height: 148rpx; }.card-image { width: 148rpx; height: 148rpx; }.card-copy { padding: 15rpx; }.card-title { font-size: 25rpx; }.card-description { font-size: 18rpx; }.archive-footer { grid-template-columns: 1fr; } }

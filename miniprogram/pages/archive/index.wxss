.placeholder {
  color: var(--deep-brown);
}

.page-shell { padding: 56rpx 8rpx 24rpx; }
.title { margin-bottom: 28rpx; font-size: 44rpx; font-weight: 700; }
.notice { padding: 18rpx 20rpx; border: 1rpx solid var(--muted-gold); border-radius: var(--card-radius); }
.description { margin: 36rpx 0; color: #735f50; }
.secondary-button { color: var(--deep-brown); background: #fff; border: 1rpx solid var(--muted-gold); }
.archive-card { margin: 24rpx 0; padding: 24rpx; background: #fff; border-radius: var(--card-radius); }
.route-name { margin-bottom: 12rpx; font-weight: 700; }
.archive-card-title { margin-top: 20rpx; font-weight: 700; }
.knowledge-card { margin-top: 12rpx; padding: 16rpx; background: #fff8ed; border-radius: 12rpx; }
.knowledge-notice { margin-top: 8rpx; color: #735f50; font-size: 22rpx; }

.progress-page { min-height: 100vh; margin: -32rpx; padding: 62rpx 30rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: var(--exhibit-text); background: var(--exhibit-bg-radial); }
.progress-intro { max-width: 620rpx; padding: 16rpx 8rpx 40rpx; }
.progress-kicker, .section-kicker { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }
.progress-title { margin-top: 13rpx; font-family: var(--exhibit-font-display); font-size: 52rpx; font-weight: 700; }
.progress-lead { margin-top: 18rpx; color: var(--exhibit-text-soft-64); font-size: 23rpx; line-height: 1.8; }

.progress-section { padding-top: 36rpx; border-top: 1rpx solid var(--exhibit-gold-line); }
.section-title { margin-top: 10rpx; font-family: var(--exhibit-font-display); font-size: 36rpx; font-weight: 700; }

.favorite-list, .report-list { margin-top: 22rpx; }
.favorite-card, .report-card { padding: 22rpx 0; border-top: 1rpx solid rgba(255, 255, 255, .12); }
.favorite-list .favorite-card:first-child, .report-list .report-card:first-child { border-top: 0; padding-top: 0; }
.favorite-name { font-family: var(--exhibit-font-display); font-size: 27rpx; font-weight: 700; }
.report-route { font-family: var(--exhibit-font-display); font-size: 26rpx; font-weight: 700; }
.report-meta { margin-top: 8rpx; color: var(--exhibit-text-soft-64); font-size: 21rpx; }
.favorite-action, .report-action { display: inline-flex; align-items: center; min-height: 64rpx; margin: 16rpx 0 0; padding: 0 22rpx; border: 1rpx solid var(--exhibit-gold-line); border-radius: 0; color: rgba(255, 248, 232, .72); background: transparent; font-size: 21rpx; }
.favorite-action text, .report-action text { margin-left: 6rpx; }
.empty-state { margin-top: 18rpx; color: var(--exhibit-text-soft-42); font-size: 22rpx; }

.progress-footer { margin-top: 44rpx; }
.footer-link { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 82rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 0; color: var(--exhibit-text-soft-64); background: transparent; font-size: 21rpx; }

@media (max-width: 360px) {
  .progress-page { padding-right: 22rpx; padding-left: 22rpx; }
  .progress-title { font-size: 46rpx; }
}

.activity-page { display: flex; min-height: 100vh; margin: -32rpx; padding: 0 30rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; flex-direction: column; color: var(--exhibit-text); background: var(--exhibit-bg-radial); }
.activity-intro { width: 100%; max-width: 620rpx; padding: 0 8rpx; box-sizing: border-box; flex: 1; }
.activity-kicker { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }
.activity-title { margin-top: 13rpx; font-family: var(--exhibit-font-display); font-size: 52rpx; font-weight: 700; }
.activity-status { margin-top: 20rpx; color: var(--exhibit-gold); font-size: 21rpx; letter-spacing: 1rpx; }
.activity-description { margin-top: 14rpx; color: var(--exhibit-text-soft-64); font-size: 23rpx; line-height: 1.8; }

@media (max-width: 360px) {
  .activity-page { padding-right: 22rpx; padding-left: 22rpx; }
  .activity-title { font-size: 46rpx; }
}

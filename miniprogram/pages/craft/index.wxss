.craft-page { min-height: 100vh; margin: -32rpx; padding: 38rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); background: #f6f7f9; color: #1f2937; box-sizing: border-box; }
.craft-intro { padding: 26rpx 28rpx 28rpx; border-radius: 20rpx; background: linear-gradient(135deg, #fff8e6, #f6e6bc); }.intro-tag { display: inline-flex; padding: 6rpx 12rpx; border-radius: 8rpx; color: #986c1b; background: rgba(255,255,255,.62); font-size: 20rpx; }.craft-title { margin-top: 18rpx; font-size: 48rpx; font-weight: 700; line-height: 1.28; }.craft-lead { margin-top: 14rpx; color: #6e6251; font-size: 24rpx; line-height: 1.72; }.source-alert { margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 10rpx; color: #836522; background: rgba(255,255,255,.58); font-size: 19rpx; line-height: 1.55; }.intro-stat { display: flex; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(165,122,39,.22); }.intro-stat view { display: flex; flex: 1; flex-direction: column; }.intro-stat text { color: #8b6218; font-size: 30rpx; font-weight: 700; }.intro-stat small { margin-top: 3rpx; color: #8c7d63; font-size: 19rpx; }
.craft-list { margin-top: 34rpx; }.step-card { display: flex; min-height: 166rpx; }.step-side { display: flex; width: 76rpx; flex-direction: column; align-items: center; }.step-number { display: grid; width: 48rpx; height: 48rpx; border: 2rpx solid #d9dee5; border-radius: 50%; place-items: center; color: #7e8793; background: #fff; font-size: 20rpx; font-weight: 700; }.step-line { width: 2rpx; margin: 10rpx 0; flex: 1; background: #dfe3e8; }.step-content { width: calc(100% - 76rpx); margin-bottom: 22rpx; padding: 24rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(31,41,55,.045); }.step-meta { display: flex; align-items: center; gap: 10rpx; color: #a4741b; font-size: 19rpx; }.key-label { padding: 3rpx 9rpx; border-radius: 6rpx; color: #c16418; background: #fff0e5; }.step-name { margin-top: 7rpx; font-size: 30rpx; font-weight: 700; }.step-name text { margin-left: 4rpx; color: #89919c; font-size: 21rpx; font-weight: 400; }.step-one-liner { margin-top: 10rpx; color: #4d5561; font-size: 24rpx; line-height: 1.6; }.step-detail { margin-top: 7rpx; color: #8d96a2; font-size: 21rpx; line-height: 1.58; }.is-key-step .step-number { border-color: #d5a43f; color: #a4741b; background: #fff4d9; }.is-key-step .step-content { border: 2rpx solid #f0dcae; background: #fffdf7; }.step-highlight { display: flex; margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 10rpx; flex-direction: column; background: #fff2d5; }.step-highlight text { color: #a66f12; font-size: 30rpx; font-weight: 700; }.step-highlight small { margin-top: 4rpx; color: #8b7758; font-size: 19rpx; line-height: 1.55; }
.next-card { display: flex; margin-top: 18rpx; padding: 22rpx; border-radius: 18rpx; align-items: center; background: #26313e; color: #fff; }.next-icon { display: grid; width: 62rpx; height: 62rpx; border-radius: 14rpx; flex: 0 0 62rpx; place-items: center; color: #ffe19a; background: rgba(255,255,255,.12); font-size: 31rpx; }.next-copy { min-width: 0; margin-left: 16rpx; flex: 1; font-size: 24rpx; font-weight: 600; }.next-copy small { display: block; margin-top: 5rpx; color: rgba(255,255,255,.65); font-size: 19rpx; font-weight: 400; }.next-button { margin: 0; padding: 0 18rpx; border-radius: 12rpx; color: #46300c; background: #f5cf73; font-size: 21rpx; line-height: 62rpx; }.craft-source { margin: 28rpx 4rpx 0; color: #a1a8b1; font-size: 19rpx; line-height: 1.7; }

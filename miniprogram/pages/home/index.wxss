.home-page { position: relative; display: flex; min-height: 100vh; margin: -32rpx; overflow: hidden; flex-direction: column; color: var(--exhibit-text); background: var(--exhibit-bg-radial); }
.ambient-gold { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }.ambient-piece { position: absolute; border: 1rpx solid rgba(236,188,87,.12); background: rgba(218,165,57,.04); transform: rotate(28deg); }.ambient-piece.one { top: 320rpx; right: -160rpx; width: 410rpx; height: 250rpx; }.ambient-piece.two { top: 940rpx; left: -180rpx; width: 420rpx; height: 300rpx; transform: rotate(-18deg); }
.home-topbar { position: relative; z-index: 3; display: flex; min-height: 88rpx; flex-shrink: 0; padding: 0 30rpx 20rpx; align-items: center; justify-content: space-between; }.home-eyebrow, .hero-eyebrow, .section-kicker, .route-entry-kicker { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }.home-brand { margin-top: 7rpx; font-family: var(--exhibit-font-display); font-size: 29rpx; }.progress-entry { display: flex; flex-shrink: 0; margin-left: auto; align-items: center; gap: 8rpx; padding: 11rpx 20rpx; border: 1rpx solid rgba(244,215,123,.4); border-radius: 30rpx; color: var(--exhibit-gold); background: rgba(244,215,123,.12); box-shadow: 0 8rpx 22rpx rgba(220,166,57,.18); font-size: 20rpx; font-weight: 700; }.progress-entry:active { opacity: .8; }.progress-entry-icon { width: 24rpx; height: 24rpx; }
.home-hero { position: relative; z-index: 1; height: 530rpx; flex-shrink: 0; overflow: hidden; }.hero-image { width: 100%; height: 100%; opacity: .7; filter: sepia(.28) saturate(.76) brightness(.64); }.hero-image-fallback { background: linear-gradient(135deg, #5a401e, #1a100a); }.hero-mask { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(16,11,8,.82), rgba(16,11,8,.22)), linear-gradient(0deg, #20140d 0%, transparent 60%); }.hero-copy { position: absolute; right: 42rpx; bottom: 42rpx; left: 42rpx; }.hero-title { margin-top: 17rpx; font-family: var(--exhibit-font-display); font-size: 54rpx; font-weight: 700; line-height: 1.22; letter-spacing: 1rpx; }.hero-subtitle { margin-top: 17rpx; color: var(--exhibit-text-soft-64); font-size: 23rpx; line-height: 1.75; }.hero-notice { display: inline-flex; margin-top: 13rpx; padding: 5rpx 10rpx; color: var(--exhibit-text-soft-64); background: rgba(0,0,0,.28); font-size: 18rpx; }
.home-content { position: relative; z-index: 2; margin-top: -12rpx; flex: 1; padding: 42rpx 30rpx calc(52rpx + env(safe-area-inset-bottom)); background: var(--exhibit-bg-panel); }.section-title { margin-top: 12rpx; font-family: var(--exhibit-font-display); font-size: 42rpx; font-weight: 700; }.section-copy { max-width: 620rpx; margin-top: 14rpx; color: var(--exhibit-text-soft-64); font-size: 23rpx; line-height: 1.75; }
.process-rail { display: flex; margin-top: 34rpx; padding: 22rpx 0 25rpx; align-items: flex-start; border-top: 1rpx solid rgba(255,255,255,.12); border-bottom: 1rpx solid rgba(255,255,255,.12); }.process-item { width: 92rpx; flex: 0 0 92rpx; color: var(--exhibit-text-soft-42); font-size: 18rpx; text-align: center; }.process-item text { color: inherit; font-family: var(--exhibit-font-display); font-size: 27rpx; }.process-item view { margin-top: 6rpx; white-space: nowrap; }.process-item.current { color: var(--exhibit-gold); }.process-line { height: 1rpx; margin-top: 15rpx; flex: 1; background: rgba(255,255,255,.14); }
.route-list { display: flex; margin-top: 34rpx; flex-direction: column; gap: 18rpx; }.route-entry { display: flex; padding: 26rpx; border: 1rpx solid var(--exhibit-gold-line); align-items: center; background: rgba(255,255,255,.045); box-shadow: 0 24rpx 64rpx rgba(0,0,0,.25); }.route-entry:active { opacity: .88; }.route-entry-seal { display: grid; width: 86rpx; height: 86rpx; flex: 0 0 86rpx; place-items: center; color: #28190d; background: var(--exhibit-gold-button); font-family: var(--exhibit-font-display); font-size: 43rpx; }.route-entry-copy { min-width: 0; margin-left: 20rpx; flex: 1; }.route-entry-kicker { font-size: 15rpx; letter-spacing: 3rpx; }.route-entry-heading { display: flex; min-width: 0; margin-top: 8rpx; align-items: center; gap: 12rpx; }.route-entry-title { min-width: 0; font-family: var(--exhibit-font-display); font-size: 31rpx; font-weight: 700; }.route-entry-status { flex-shrink: 0; padding: 4rpx 9rpx; border: 1rpx solid var(--exhibit-gold-line); color: var(--exhibit-gold); font-size: 15rpx; }.route-entry-desc { margin-top: 7rpx; color: var(--exhibit-text-soft-42); font-size: 19rpx; }.route-entry-arrow { margin-left: 16rpx; color: var(--exhibit-gold); font-size: 40rpx; }

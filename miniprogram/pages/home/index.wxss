.home-page { position: relative; display: flex; min-height: 100vh; margin: -32rpx; overflow: hidden; flex-direction: column; color: var(--exhibit-text); background: var(--exhibit-bg-radial); }
.ambient-gold { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }.ambient-piece { position: absolute; border: 1rpx solid rgba(236,188,87,.12); background: rgba(218,165,57,.04); transform: rotate(28deg); }.ambient-piece.one { top: 320rpx; right: -160rpx; width: 410rpx; height: 250rpx; }.ambient-piece.two { top: 940rpx; left: -180rpx; width: 420rpx; height: 300rpx; transform: rotate(-18deg); }
.home-topbar { position: relative; z-index: 3; display: flex; min-height: 88rpx; flex-shrink: 0; padding: 0 30rpx 20rpx; align-items: center; justify-content: space-between; }.home-eyebrow, .hero-eyebrow, .section-kicker, .entry-kicker { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }.home-brand { margin-top: 7rpx; font-family: var(--exhibit-font-display); font-size: 29rpx; }.topbar-state { padding: 8rpx 14rpx; border: 1rpx solid var(--exhibit-gold-line); border-radius: 28rpx; color: var(--exhibit-gold); background: rgba(244,215,123,.05); font-size: 17rpx; }
.home-hero { position: relative; z-index: 1; height: 530rpx; flex-shrink: 0; overflow: hidden; }.hero-image { width: 100%; height: 100%; opacity: .7; filter: sepia(.28) saturate(.76) brightness(.64); }.hero-image-fallback { background: linear-gradient(135deg, #5a401e, #1a100a); }.hero-mask { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(16,11,8,.82), rgba(16,11,8,.22)), linear-gradient(0deg, #20140d 0%, transparent 60%); }.hero-copy { position: absolute; right: 42rpx; bottom: 42rpx; left: 42rpx; }.hero-title { margin-top: 17rpx; font-family: var(--exhibit-font-display); font-size: 54rpx; font-weight: 700; line-height: 1.22; letter-spacing: 1rpx; }.hero-subtitle { margin-top: 17rpx; color: rgba(255,248,232,.75); font-size: 23rpx; line-height: 1.75; }.hero-notice { display: inline-flex; margin-top: 13rpx; padding: 5rpx 10rpx; color: rgba(255,248,232,.58); background: rgba(0,0,0,.28); font-size: 18rpx; }
.home-content { position: relative; z-index: 2; margin-top: -12rpx; flex: 1; padding: 42rpx 30rpx calc(52rpx + env(safe-area-inset-bottom)); background: var(--exhibit-bg-panel); }.section-title { margin-top: 12rpx; font-family: var(--exhibit-font-display); font-size: 42rpx; font-weight: 700; }.section-copy { max-width: 620rpx; margin-top: 14rpx; color: rgba(255,248,232,.58); font-size: 23rpx; line-height: 1.75; }
.process-rail { display: flex; margin-top: 34rpx; padding: 22rpx 0 25rpx; align-items: flex-start; border-top: 1rpx solid rgba(255,255,255,.12); border-bottom: 1rpx solid rgba(255,255,255,.12); }.process-item { width: 92rpx; flex: 0 0 92rpx; color: rgba(255,248,232,.38); font-size: 18rpx; text-align: center; }.process-item text { color: inherit; font-family: var(--exhibit-font-display); font-size: 27rpx; }.process-item view { margin-top: 6rpx; white-space: nowrap; }.process-item.current { color: var(--exhibit-gold); }.process-line { height: 1rpx; margin-top: 15rpx; flex: 1; background: rgba(255,255,255,.14); }
.entry-panel { display: flex; margin-top: 34rpx; padding: 26rpx; border: 1rpx solid var(--exhibit-gold-line); align-items: center; background: rgba(255,255,255,.045); box-shadow: 0 24rpx 64rpx rgba(0,0,0,.25); }.entry-seal { display: grid; width: 86rpx; height: 86rpx; flex: 0 0 86rpx; place-items: center; color: #28190d; background: var(--exhibit-gold-button); font-family: var(--exhibit-font-display); font-size: 43rpx; }.entry-copy { min-width: 0; margin-left: 20rpx; flex: 1; }.entry-kicker { font-size: 15rpx; letter-spacing: 3rpx; }.entry-title { margin-top: 8rpx; font-family: var(--exhibit-font-display); font-size: 31rpx; font-weight: 700; }.entry-desc { margin-top: 7rpx; color: rgba(255,248,232,.52); font-size: 19rpx; }.entry-arrow { margin-left: 16rpx; color: var(--exhibit-gold); font-size: 40rpx; }
.gold-button { display: flex; width: 100%; min-height: 100rpx; margin-top: 18rpx; padding: 0 30rpx; align-items: center; justify-content: center; border-radius: 0; color: #26180e; background: var(--exhibit-gold-button); box-shadow: 0 16rpx 36rpx rgba(220,166,57,.22); font-size: 27rpx; font-weight: 700; letter-spacing: 2rpx; }.home-links { display: flex; margin-top: 37rpx; justify-content: center; gap: 22rpx; color: var(--exhibit-text-soft-64); font-size: 22rpx; white-space: nowrap; }.home-links view { width: 1rpx; height: 26rpx; background: rgba(255,255,255,.24); }.source-note { margin: 25rpx 6rpx 0; color: rgba(255,248,232,.36); font-size: 18rpx; line-height: 1.65; text-align: center; }

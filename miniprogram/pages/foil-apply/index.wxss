.foil-page { min-height: 100vh; margin: -32rpx; padding: 38rpx 32rpx calc(50rpx + env(safe-area-inset-bottom)); background: #f6f7f9; color: #1f2937; box-sizing: border-box; }.foil-heading { display: flex; align-items: center; justify-content: space-between; }.page-tag { display: inline-flex; padding: 6rpx 12rpx; border-radius: 8rpx; color: #9d701d; background: #fff1ce; font-size: 20rpx; }.foil-title { margin-top: 13rpx; font-size: 42rpx; font-weight: 700; }.foil-desc { margin-top: 8rpx; color: #8a929e; font-size: 23rpx; }.progress-badge { display: flex; width: 96rpx; height: 96rpx; border-radius: 50%; flex-direction: column; align-items: center; justify-content: center; color: #a4741b; background: #fff; box-shadow: 0 6rpx 20rpx rgba(31,41,55,.07); }.progress-badge text { font-size: 27rpx; font-weight: 700; }.progress-badge small { margin-top: 1rpx; color: #929aa5; font-size: 18rpx; }.guide-card { display: flex; margin-top: 28rpx; padding: 18rpx 20rpx; border-radius: 12rpx; align-items: center; color: #735f37; background: #fff4d9; font-size: 22rpx; }.guide-dot { display: grid; width: 34rpx; height: 34rpx; margin-right: 12rpx; border-radius: 50%; flex: 0 0 34rpx; place-items: center; color: #fff; background: #c79532; font-size: 20rpx; font-weight: 700; }
.application-stage { position: relative; height: 650rpx; margin-top: 24rpx; overflow: hidden; border: 2rpx solid #e1e5ea; border-radius: 20rpx; background: #fff; touch-action: none; }.stage-label { position: absolute; z-index: 3; top: 20rpx; left: 0; right: 0; color: #a4abb4; font-size: 21rpx; text-align: center; }.artifact-outline { position: absolute; z-index: 2; top: 92rpx; left: 50%; width: 280rpx; height: 458rpx; transform: translateX(-50%); }.artifact-crown { width: 136rpx; height: 86rpx; margin: 0 auto; border: 4rpx dashed #d4a43e; border-bottom: 0; border-radius: 16rpx 16rpx 0 0; }.artifact-body { display: flex; width: 238rpx; height: 246rpx; margin: 0 auto; border: 4rpx dashed #d4a43e; align-items: center; justify-content: center; color: #cab57f; background: #fffdf6; font-size: 23rpx; }.artifact-base { width: 280rpx; height: 66rpx; margin: 0 auto; border: 4rpx dashed #d4a43e; border-top: 0; border-radius: 0 0 12rpx 12rpx; }.coverage-mask { position: absolute; z-index: 1; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(250,219,131,.2), rgba(223,174,52,.42)); transition: height .2s ease; }.foil-sheet { position: absolute; z-index: 4; display: grid; width: 82rpx; height: 82rpx; border: 3rpx solid #d39e2c; border-radius: 10rpx; place-items: center; color: #a4741b; background: #ffe7a3; box-shadow: 0 6rpx 14rpx rgba(160,113,22,.18); font-size: 38rpx; font-weight: 700; transform: translate(-50%,-50%); }.break-tip { position: absolute; z-index: 5; top: 50%; left: 50%; display: flex; padding: 16rpx 22rpx; border-radius: 12rpx; flex-direction: column; align-items: center; color: #b84f3b; background: rgba(255,247,244,.96); box-shadow: 0 8rpx 22rpx rgba(129,48,31,.14); transform: translate(-50%,-50%); }.break-tip text { font-size: 28rpx; font-weight: 700; }.break-tip small { margin-top: 4rpx; font-size: 19rpx; white-space: nowrap; }.complete-tip { position: absolute; z-index: 5; right: 20rpx; bottom: 20rpx; padding: 11rpx 15rpx; border-radius: 10rpx; color: #317453; background: #e8f6ec; font-size: 22rpx; font-weight: 600; }
.application-status { display: flex; margin-top: 22rpx; padding: 22rpx; border-radius: 16rpx; align-items: center; justify-content: space-between; background: #fff; }.application-status view:not(:empty) { display: flex; flex-direction: column; align-items: center; }.application-status view:empty { width: 1rpx; height: 44rpx; background: #eef0f3; }.application-status small { color: #9ba2ac; font-size: 19rpx; }.application-status text { margin-top: 4rpx; color: #4e5763; font-size: 25rpx; font-weight: 700; }.foil-message { min-height: 64rpx; margin: 22rpx 2rpx 0; color: #78818c; font-size: 23rpx; line-height: 1.6; }.foil-message.is-error { color: #b74e38; }.foil-actions { display: flex; gap: 18rpx; }.foil-actions button { height: 88rpx; border-radius: 14rpx; font-size: 25rpx; }.secondary-button { width: 31%; color: #67717c; background: #fff; }.primary-button { flex: 1; color: #fff; background: #bb8929; }.primary-button[disabled] { color: #a8afb8; background: #e8ebee; }.foil-note { margin: 24rpx 2rpx 0; color: #a0a7b0; font-size: 19rpx; line-height: 1.65; }

.result-page { min-height: 100vh; margin: -32rpx; padding: 42rpx 32rpx calc(50rpx + env(safe-area-inset-bottom)); background: #f6f7f9; color: #1f2937; box-sizing: border-box; }.result-card { padding: 38rpx 28rpx 30rpx; border-radius: 22rpx; background: #fff; text-align: center; box-shadow: 0 10rpx 30rpx rgba(31,41,55,.07); }.success-mark { display: grid; width: 64rpx; height: 64rpx; margin: 0 auto; border-radius: 50%; place-items: center; color: #fff; background: #55a878; font-size: 38rpx; }.result-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 700; }.result-desc { margin-top: 8rpx; color: #8b949f; font-size: 23rpx; }.result-artifact { width: 260rpx; height: 336rpx; margin: 34rpx auto 26rpx; }.result-crown { width: 120rpx; height: 62rpx; margin: 0 auto; border: 4rpx solid #d0a244; border-bottom: 0; border-radius: 15rpx 15rpx 0 0; }.result-body { display: flex; width: 220rpx; height: 190rpx; margin: 0 auto; border: 4rpx solid #d0a244; align-items: center; justify-content: center; color: #bd8e2d; background: #fff9e8; font-size: 76rpx; font-weight: 700; }.result-base { width: 260rpx; height: 52rpx; margin: 0 auto; border: 4rpx solid #d0a244; border-top: 0; border-radius: 0 0 12rpx 12rpx; }.result-data { display: flex; padding-top: 22rpx; border-top: 1rpx solid #eef0f2; justify-content: space-around; }.result-data view { display: flex; flex-direction: column; }.result-data small { color: #9fa6af; font-size: 19rpx; }.result-data text { margin-top: 6rpx; color: #4d5662; font-size: 26rpx; font-weight: 700; }.reflection-card { margin-top: 22rpx; padding: 22rpx 24rpx; border-radius: 16rpx; color: #7d6b46; background: #fff4d9; font-size: 23rpx; line-height: 1.65; }.reflection-title { margin-bottom: 6rpx; color: #a4741b; font-size: 24rpx; font-weight: 700; }.result-primary, .result-secondary { width: 100%; height: 90rpx; border-radius: 14rpx; font-size: 26rpx; }.result-primary { margin-top: 32rpx; color: #fff; background: #bb8929; }.result-secondary { margin-top: 16rpx; color: #66717d; background: #fff; }

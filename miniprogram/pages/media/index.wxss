.media-page { min-height: 100vh; color: #f9f0da; background: radial-gradient(circle at 92% 0, #52351c, #20140d 36%, #100b08 80%); }
.media-topbar { display: flex; padding: calc(30rpx + env(safe-area-inset-top)) 30rpx 20rpx; align-items: center; justify-content: space-between; }.eyebrow { color: #d7ad57; font-size: 18rpx; letter-spacing: 4rpx; }.brand { margin-top: 7rpx; font-family: serif; font-size: 31rpx; }.back-button { min-width: 94rpx; margin: 0; padding: 9rpx 15rpx; border: 1rpx solid rgba(244,215,123,.3); border-radius: 0; color: #efcc73; background: rgba(244,215,123,.05); font-size: 20rpx; }
.media-hero { position: relative; margin: 18rpx 30rpx 0; padding: 52rpx 32rpx 48rpx; overflow: hidden; border: 1rpx solid rgba(244,215,123,.2); background: linear-gradient(125deg, rgba(106,71,33,.5), rgba(22,14,10,.88)); }.hero-shape { position: absolute; border: 1rpx solid rgba(244,215,123,.16); transform: rotate(28deg); }.hero-shape.one { top: -120rpx; right: -80rpx; width: 310rpx; height: 210rpx; }.hero-shape.two { right: 74rpx; bottom: -162rpx; width: 360rpx; height: 240rpx; transform: rotate(-18deg); }.hero-title { position: relative; margin-top: 19rpx; font-family: serif; font-size: 50rpx; font-weight: 700; line-height: 1.2; }.hero-copy { position: relative; margin-top: 18rpx; color: rgba(255,248,232,.65); font-size: 22rpx; line-height: 1.75; }
.media-content { padding: 50rpx 30rpx calc(54rpx + env(safe-area-inset-bottom)); }.category-intro { margin-bottom: 23rpx; color: rgba(255,248,232,.6); font-family: serif; font-size: 27rpx; }.category-intro .eyebrow { margin-bottom: 12rpx; }.category-card { display: flex; min-height: 232rpx; margin-top: 18rpx; padding: 28rpx 25rpx; box-sizing: border-box; border: 1rpx solid rgba(244,215,123,.18); background: linear-gradient(115deg, rgba(108,73,35,.28), rgba(255,255,255,.025)); }.category-card:active { opacity: .84; }.category-order { min-width: 62rpx; color: rgba(236,198,104,.5); font-family: serif; font-size: 32rpx; }.category-main { min-width: 0; flex: 1; }.category-title { margin-top: 10rpx; font-family: serif; font-size: 38rpx; font-weight: 700; }.category-description { margin-top: 13rpx; color: rgba(255,248,232,.61); font-size: 22rpx; line-height: 1.65; }.category-footer { display: flex; margin-top: 21rpx; align-items: center; justify-content: space-between; color: rgba(255,248,232,.42); font-size: 19rpx; }.category-arrow { color: #e7c66f; }
@media (max-width: 360px) { .hero-title { font-size: 45rpx; }.category-title { font-size: 35rpx; }.category-card { padding-right: 20rpx; padding-left: 20rpx; } }

.media-page { display: flex; min-height: 100vh; margin: -32rpx; flex-direction: column; color: var(--exhibit-text); background: var(--exhibit-bg-radial); }.eyebrow { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }
.media-hero { position: relative; margin: 0 30rpx; padding: 52rpx 32rpx 48rpx; overflow: hidden; border: 1rpx solid var(--exhibit-gold-line); background: linear-gradient(125deg, rgba(106,71,33,.5), rgba(22,14,10,.88)); }.hero-shape { position: absolute; border: 1rpx solid var(--exhibit-gold-line); transform: rotate(28deg); }.hero-shape.one { top: -120rpx; right: -80rpx; width: 310rpx; height: 210rpx; }.hero-shape.two { right: 74rpx; bottom: -162rpx; width: 360rpx; height: 240rpx; transform: rotate(-18deg); }.hero-title { position: relative; margin-top: 19rpx; font-family: var(--exhibit-font-display); font-size: 50rpx; font-weight: 700; line-height: 1.2; }.hero-copy { position: relative; margin-top: 18rpx; color: rgba(255,248,232,.65); font-size: 22rpx; line-height: 1.75; }
.media-content { display: flex; flex-direction: column; padding: 50rpx 30rpx 42rpx; }.category-intro { margin-bottom: 23rpx; color: rgba(255,248,232,.6); font-family: var(--exhibit-font-display); font-size: 27rpx; }.category-intro .eyebrow { margin-bottom: 12rpx; }.category-list { display: flex; flex-direction: column; gap: 18rpx; }.category-card { display: flex; min-height: 232rpx; padding: 28rpx 25rpx; box-sizing: border-box; border: 1rpx solid var(--exhibit-gold-line); background: linear-gradient(115deg, rgba(108,73,35,.28), rgba(255,255,255,.025)); }.category-card:active { opacity: .84; }.category-order { min-width: 62rpx; color: rgba(236,198,104,.5); font-family: var(--exhibit-font-display); font-size: 32rpx; }.category-main { display: flex; min-width: 0; flex: 1; flex-direction: column; }.category-title { margin-top: 10rpx; font-family: var(--exhibit-font-display); font-size: 38rpx; font-weight: 700; }.category-description { margin-top: 13rpx; color: rgba(255,248,232,.61); font-size: 22rpx; line-height: 1.65; }.category-footer { display: flex; margin-top: 21rpx; align-items: center; justify-content: space-between; color: var(--exhibit-text-soft-42); font-size: 19rpx; }.category-arrow { color: var(--exhibit-gold); }.media-footer { margin-top: 56rpx; padding: 0 30rpx calc(54rpx + env(safe-area-inset-bottom)); }.footer-link { display: flex; width: 100%; min-height: 82rpx; margin: 0; padding: 0 18rpx; align-items: center; justify-content: center; border: 1rpx solid var(--exhibit-gold-line); border-radius: 0; color: var(--exhibit-gold); background: transparent; font-size: 21rpx; }
@media (max-width: 360px) { .hero-title { font-size: 45rpx; }.category-title { font-size: 35rpx; }.category-card { padding-right: 20rpx; padding-left: 20rpx; } }

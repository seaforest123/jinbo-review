.experience-shell { min-height: 100vh; margin: -32rpx; padding: 0 30rpx calc(50rpx + env(safe-area-inset-bottom)); color: var(--exhibit-text); background: var(--exhibit-bg-radial); }
.topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.demo-mode-tag { flex-shrink: 0; padding: 8rpx 16rpx; border: 1rpx solid var(--exhibit-demo-accent-line); border-radius: 28rpx; color: var(--exhibit-demo-accent); background: var(--exhibit-demo-accent-bg); font-size: 15rpx; letter-spacing: 1rpx; white-space: nowrap; }
.route-tag { flex-shrink: 0; padding: 8rpx 16rpx; border: 1rpx solid var(--exhibit-gold-line); border-radius: 28rpx; color: var(--exhibit-gold); background: rgba(244,215,123,.05); font-size: 15rpx; letter-spacing: 1rpx; white-space: nowrap; }
.eyebrow { color: var(--exhibit-gold); font-size: 18rpx; letter-spacing: var(--exhibit-font-kicker-tracking); }
.brand { margin-top: 10rpx; font-family: var(--exhibit-font-display); font-size: 29rpx; }
.opening { display: flex; min-height: 80vh; padding: 60rpx 18rpx; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.seal { display: grid; width: 128rpx; height: 128rpx; margin-bottom: 48rpx; color: #2a190d; background: var(--exhibit-gold-button); font-family: var(--exhibit-font-display); font-size: 58rpx; place-items: center; transform: translateX(28rpx) rotate(3deg); box-shadow: 0 0 70rpx rgba(226,178,69,.25); }
.hero-title { margin-top: 25rpx; font-family: var(--exhibit-font-display); font-size: 60rpx; line-height: 1.3; }
.hero-copy { max-width: 650rpx; margin: 26rpx 0 46rpx; padding-left: 24rpx; border-left: 2rpx solid var(--exhibit-gold-line); color: rgba(255,248,232,.66); font-size: 25rpx; line-height: 1.8; text-align: left; }
.demo-route-preview { display: flex; margin: -12rpx 0 30rpx; padding: 17rpx 26rpx; align-items: center; justify-content: center; gap: 18rpx; border: 1rpx solid rgba(244,215,123,.2); border-radius: 44rpx; color: #f0d37d; background: rgba(244,215,123,.045); font-size: 20rpx; }
.demo-route-arrow { color: rgba(255,248,232,.35); }
.gold-button { display: flex; width: 100%; min-height: 100rpx; margin: 22rpx 0 0; padding: 0 30rpx; align-items: center; justify-content: center; color: #26180e; background: var(--exhibit-gold-button); font-size: 27rpx; font-weight: 700; letter-spacing: 2rpx; text-align: center; }
.gold-button[disabled] { opacity: .32; }
.gold-button.is-ready { opacity: 1; box-shadow: 0 16rpx 36rpx rgba(220,166,57,.3),0 0 0 1rpx rgba(255,236,167,.28); animation: ready-button 1.8s ease-in-out infinite; }
.opening .gold-button { max-width: 620rpx; }
.outline-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 82rpx; margin-top: 18rpx; border: 1rpx solid var(--exhibit-gold-line); color: var(--exhibit-gold); background: transparent; font-size: 21rpx; }
.intro-list { display: grid; width: 100%; margin: 38rpx 0 20rpx; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.intro-list view { padding: 22rpx; border: 1rpx solid rgba(255,255,255,.1); color: rgba(255,248,232,.7); background: rgba(255,255,255,.035); text-align: center; }
.workshop { padding-top: 34rpx; }
.task-rail { width: 100%; white-space: nowrap; }
.task { display: inline-block; width: 135rpx; margin-right: 9rpx; padding: 17rpx 15rpx; border-top: 2rpx solid rgba(255,255,255,.13); color: rgba(255,255,255,.3); font-size: 18rpx; }
.task text { font-family: var(--exhibit-font-display); font-size: 24rpx; }.task.current { border-color: var(--exhibit-gold); color: var(--exhibit-gold); }.task.completed { color: var(--exhibit-gold-soft-60); }
.heading { padding: 42rpx 5rpx 24rpx; }.step-title { margin-top: 10rpx; font-family: var(--exhibit-font-display); font-size: 43rpx; }.instruction { margin-top: 14rpx; color: rgba(255,248,232,.52); font-size: 21rpx; }
.action-demo { position: relative; margin-bottom: 20rpx; overflow: hidden; border-radius: 22rpx; }.action-demo video-player { display: block; width: 100%; }.action-demo button { display: flex; align-items: center; justify-content: center; position: absolute; right: 14rpx; bottom: 14rpx; width: auto; min-height: 56rpx; margin: 0; padding: 0 20rpx; color: #fff; background: rgba(0,0,0,.64); font-size: 17rpx; }
.panel { position: relative; padding: 28rpx; border: 1rpx solid rgba(244,215,123,.2); border-radius: 28rpx; background: rgba(255,255,255,.045); box-shadow: 0 28rpx 70rpx rgba(0,0,0,.25); }
.cut-bench { position: relative; height: 260rpx; overflow: hidden; border-radius: 18rpx; background: repeating-linear-gradient(90deg,#302115 0 36rpx,#281a11 36rpx 72rpx); }
.gold-strip { position: absolute; top: 93rpx; right: 35rpx; left: 35rpx; height: 70rpx; background: linear-gradient(90deg,#9f6516,#f7dc82,#b87519); box-shadow: 0 10rpx 28rpx rgba(0,0,0,.4); }
.safe-zone { position: absolute; top: 54rpx; bottom: 48rpx; left: 44%; width: 12%; border: 2rpx dashed rgba(255,255,255,.6); color: rgba(255,255,255,.6); font-size: 16rpx; text-align: center; }
.cutter { position: absolute; z-index: 2; top: 33rpx; width: 8rpx; height: 188rpx; background: #eee3c5; box-shadow: 0 0 12rpx #fff; transform: translateX(-50%); }.cutter text { position: absolute; top: -5rpx; left: 15rpx; color: #fff; font-size: 17rpx; }
.feedback { display: flex; height: 76rpx; margin-top: 14rpx; padding: 0 12rpx; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; color: rgba(255,248,232,.62); font-size: 20rpx; line-height: 1.45; text-align: center; }.counter { margin-top: 8rpx; color: rgba(255,255,255,.45); text-align: center; }.counter text { color: #f0ce75; font-family: serif; font-size: 42rpx; }
.paper-pack { position: relative; height: 390rpx; overflow: hidden; border-radius: 20rpx; background: #21160f; }.paper-layer { position: absolute; top: 105rpx; left: 50%; width: 420rpx; height: 220rpx; border: 1rpx solid #6c553d; background: linear-gradient(135deg,#6a5944,#30271e); transform: translateX(-50%) rotate(-3deg); }.layer-two { transform: translateX(-50%) rotate(3deg); opacity: .72; }
.placement-target { position: absolute; z-index: 2; top: 155rpx; left: 50%; display: grid; width: 125rpx; height: 125rpx; border: 2rpx dashed #e1bd68; color: rgba(244,215,123,.45); font-size: 18rpx; place-items: center; transform: translateX(-50%); }
.loose-sheet { position: absolute; z-index: 3; top: 176rpx; left: calc(50% - 46rpx); width: 92rpx; height: 92rpx; background: linear-gradient(135deg,#a96e19,#f8df88,#b6751c); box-shadow: 0 12rpx 30rpx rgba(0,0,0,.38); }.sheet-glint { width: 2rpx; height: 100%; margin-left: 28%; background: rgba(255,255,255,.55); transform: rotate(22deg); }
.grid,.inspect-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; }.cell { display: grid; aspect-ratio: 1; min-height: 0; margin: 0; padding: 0; border: 1rpx solid rgba(255,255,255,.12); border-radius: 10rpx; color: #2a180d; background: #d6a844; place-items: center; }.cell text { font-size: 18rpx; }
.cell.thick,.inspect-cell.thick { background: #ffe6a0; }.cell.ideal,.inspect-cell.ideal { background: #d5a13c; }.cell.thin,.inspect-cell.thin { color: #fff; background: #8b5528; }.cell.risk,.inspect-cell.risk { color: #fff; background: #7e2b24; box-shadow: inset 0 0 0 3rpx #d8735d; }
.metric-row { display: flex; justify-content: space-around; margin-top: 20rpx; padding: 18rpx 8rpx; border-top: 1rpx solid rgba(255,255,255,.1); color: rgba(255,255,255,.5); font-size: 18rpx; }.metric-row text { color: #f0ce75; font-size: 24rpx; }
.inspection-surface { position: relative; height: 410rpx; overflow: hidden; border-radius: 18rpx; background: #100b08; }.inspect-grid { position: absolute; inset: 18rpx; }.inspect-cell { border-radius: 2rpx; }.scan-light { position: absolute; top: 0; bottom: 0; width: 50rpx; background: linear-gradient(90deg,transparent,rgba(255,255,255,.72),transparent); filter: blur(5rpx); transform: translateX(-50%); }.swipe-copy { position: absolute; bottom: 20rpx; width: 100%; color: rgba(255,255,255,.75); font-size: 18rpx; text-align: center; }
.decision-note,.quality-badge { margin-top: 18rpx; padding: 18rpx; color: #e5c873; background: rgba(229,200,115,.07); font-size: 20rpx; text-align: center; }.decision-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.decision-row button { min-height: 90rpx; }
.final-foil { position: relative; display: grid; height: 430rpx; grid-template-columns: repeat(4,1fr); overflow: hidden; border: 12rpx solid #eadbbd; background: #c79532; box-shadow: 0 25rpx 55rpx rgba(0,0,0,.35); }.final-cell { border: 1rpx solid rgba(70,38,11,.13); }.final-cell.thick { background: #f9db82; }.final-cell.ideal { background: #d9a63c; }.final-cell.thin { background: #98622c; }.final-cell.risk { background: radial-gradient(circle at 65% 35%,#2c1b12 0 10%,#79372a 12% 30%,#a76a2b 62%); }
.cut-lines { position: absolute; z-index: 2; inset: 0; background: linear-gradient(90deg,transparent 24.6%,rgba(60,32,10,.45) 25%,transparent 25.4%,transparent 49.6%,rgba(60,32,10,.45) 50%,transparent 50.4%,transparent 74.6%,rgba(60,32,10,.45) 75%,transparent 75.4%),linear-gradient(transparent 24.6%,rgba(60,32,10,.45) 25%,transparent 25.4%,transparent 49.6%,rgba(60,32,10,.45) 50%,transparent 50.4%,transparent 74.6%,rgba(60,32,10,.45) 75%,transparent 75.4%); }.feather { position: absolute; z-index: 4; bottom: 25rpx; font-size: 52rpx; transition: left .35s ease; transform: rotate(-18deg); }
.knowledge-flash { margin-top: 20rpx; padding: 20rpx 24rpx; border-left: 4rpx solid #d7ad57; color: #473421; background: #eadfc9; font-size: 20rpx; }.curator { margin-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.1); }.curator>button { display: flex; width: 100%; min-height: 80rpx; margin: 0; padding: 0; align-items: center; justify-content: space-between; color: rgba(255,255,255,.65); background: transparent; text-align: left; }.placard { padding: 25rpx; color: #493728; background: #eadfc9; font-size: 21rpx; line-height: 1.7; }.placard .eyebrow { color: #8b5d24; }.placard-title { font-family: serif; font-size: 29rpx; font-weight: 700; }.placard small { display: block; margin-top: 12rpx; color: #89715e; }.utility { display: flex; gap: 12rpx; margin-top: 15rpx; }.utility button { flex: 1; min-height: 72rpx; border: 1rpx solid rgba(255,255,255,.12); color: rgba(255,255,255,.5); background: rgba(255,255,255,.03); }
.completion-overlay { position: fixed; z-index: 30; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f7dc8a; background: radial-gradient(circle,#5a3a1d,#120b07 70%); font-family: serif; font-size: 29rpx; }.completion-overlay .seal { margin-bottom: 35rpx; }
@media (max-width: 360px) { .experience-shell { padding-left: 22rpx; padding-right: 22rpx; }.hero-title { font-size: 50rpx; }.panel { padding: 20rpx; } }
@media (min-width: 900px) { .experience-shell { max-width: 1060px; margin: -32rpx auto; padding-left: 80px; padding-right: 80px; box-shadow: 0 0 120px #000; }.workshop,.opening { max-width: 820px; margin: auto; } }

/* v3 material rendering: one grid source, three distinct craft scenes. */
.hammer-workbench { position: relative; height: 510rpx; overflow: hidden; border-radius: 22rpx; background: radial-gradient(circle at 50% 48%, #5b422b, #251810 72%); box-shadow: inset 0 0 70rpx rgba(0,0,0,.62); }
.pack-paper { position: absolute; left: 8%; right: 8%; top: 13%; height: 74%; border: 1rpx solid rgba(213,190,153,.24); border-radius: 12rpx 22rpx 14rpx 25rpx; background: repeating-linear-gradient(8deg, rgba(255,255,255,.025) 0 2rpx, transparent 2rpx 12rpx), linear-gradient(145deg,#554634,#2c241c); box-shadow: 0 26rpx 50rpx rgba(0,0,0,.42); }
.paper-under { transform: rotate(-4deg); }.paper-over { opacity: .65; transform: rotate(4deg); }
.hammer-foil { position: absolute; z-index: 2; top: 19%; left: 16%; display: grid; width: 68%; aspect-ratio: 1; grid-template-columns: repeat(4,1fr); overflow: hidden; border-radius: 8rpx 17rpx 10rpx 14rpx; background: #c9942f; box-shadow: 0 0 0 7rpx rgba(240,205,112,.12), 0 24rpx 50rpx rgba(0,0,0,.4); transform-origin: center; }
.hammer-foil.is-rotating { animation: pack-turn .46s cubic-bezier(.25,.75,.28,1) both; }
.foil-zone { position: relative; min-height: 0; margin: -1rpx; padding: 0; overflow: hidden; border: 0; border-radius: 0; background: hsl(41,65%,var(--foil-light)); transition: transform .15s ease, filter .22s ease, background .25s ease; }
.foil-zone::after { position: absolute; inset: 0; content: ""; border: 1rpx solid rgba(100,58,16,.055); pointer-events: none; }
.foil-zone.is-hit { z-index: 4; animation: local-hammer .36s cubic-bezier(.2,.8,.3,1); }
.zone-sheen { position: absolute; inset: -20%; opacity: var(--foil-sheen); background: linear-gradient(118deg,transparent 23%,rgba(255,248,199,.72) 39%,rgba(255,255,255,.18) 43%,transparent 61%); transform: translateX(calc((var(--seed) - 2) * 5%)); }
.zone-texture { position: absolute; inset: 0; opacity: var(--foil-texture); background: repeating-linear-gradient(103deg,rgba(255,247,199,.24) 0 1rpx,transparent 1rpx 8rpx), repeating-linear-gradient(8deg,rgba(91,51,13,.12) 0 1rpx,transparent 1rpx 13rpx); }
.texture-1 { transform: rotate(7deg); }.texture-2 { transform: rotate(-5deg); }.texture-3 { transform: rotate(12deg); }.texture-4 { transform: rotate(-11deg); }
.zone-flaw { position: absolute; inset: 0; opacity: var(--foil-flaw); background: radial-gradient(circle at 26% 31%,#28170e 0 3rpx,transparent 4rpx), radial-gradient(circle at 68% 62%,#402116 0 5rpx,transparent 7rpx), radial-gradient(ellipse at 46% 78%,rgba(70,31,19,.75),transparent 28%); }
.foil-zone.thin .zone-sheen,.inspection-patch.thin .zone-sheen,.finish-patch.thin .zone-sheen { filter: saturate(.55); }
.foil-unifying-glow { position: absolute; z-index: 5; inset: 0; pointer-events: none; background: radial-gradient(circle at 36% 24%,rgba(255,241,174,.18),transparent 35%), linear-gradient(145deg,transparent 55%,rgba(83,41,12,.16)); box-shadow: inset 0 0 18rpx rgba(255,244,186,.22); }
.hammer-shadow { position: absolute; z-index: 5; top: 18rpx; right: 27rpx; display: grid; width: 70rpx; height: 70rpx; border: 1rpx solid rgba(244,215,123,.3); border-radius: 50%; color: rgba(244,215,123,.64); background: rgba(15,9,6,.5); font-family: serif; font-size: 24rpx; place-items: center; }
.rotate-button { display: flex; width: 100%; min-height: 96rpx; margin-top: 18rpx; padding: 15rpx 24rpx; flex-direction: column; align-items: flex-start; justify-content: center; border: 1rpx solid rgba(255,255,255,.1); color: rgba(255,255,255,.34); background: rgba(255,255,255,.025); text-align: left; }
.rotate-button text { font-size: 22rpx; }.rotate-button small { margin-top: 5rpx; font-size: 17rpx; }
.rotate-button.is-unlocked { border-color: rgba(240,205,112,.55); color: #efd078; background: linear-gradient(90deg,rgba(240,205,112,.12),rgba(240,205,112,.035)); box-shadow: 0 0 28rpx rgba(240,205,112,.1); }

.inspection-surface { height: 520rpx; background: radial-gradient(circle at 52% 45%,#d8c6a4,#6d5940 72%,#2b2118); }
.opened-paper { position: absolute; top: 11%; left: 6%; width: 88%; height: 76%; border-radius: 18rpx 8rpx 25rpx 12rpx; background: repeating-linear-gradient(5deg,rgba(255,255,255,.07) 0 1rpx,transparent 1rpx 11rpx),#554635; box-shadow: 0 28rpx 55rpx rgba(0,0,0,.36); }
.paper-back-a { transform: rotate(-5deg); }.paper-back-b { opacity: .72; transform: rotate(5deg); }
.inspection-foil { position: absolute; z-index: 2; top: 16%; left: 14%; width: 72%; aspect-ratio: 1; overflow: hidden; border-radius: 6rpx 19rpx 9rpx 15rpx; background: #ca9632; box-shadow: 0 0 0 8rpx rgba(246,226,167,.18), 0 25rpx 55rpx rgba(0,0,0,.32); }
.inspection-patch,.finish-patch { position: absolute; width: calc(25% + 2rpx); height: calc(25% + 2rpx); margin: -1rpx; overflow: hidden; background: hsl(41,65%,var(--foil-light)); }
button.inspection-patch { padding: 0; border: 0; border-radius: 0; line-height: normal; }
button.inspection-patch::after { border: 0; border-radius: 0; }
.inspection-patch.is-probed { z-index: 5; box-shadow: inset 0 0 0 3rpx rgba(255,241,179,.72),inset 0 0 24rpx rgba(255,247,213,.18); }
.probe-marker { position: absolute; z-index: 6; top: 50%; left: 50%; display: grid; width: 42rpx; height: 42rpx; border: 1rpx solid rgba(255,244,197,.72); border-radius: 50%; color: #f8e7ad; background: rgba(45,28,16,.78); font-size: 17rpx; place-items: center; pointer-events: none; transform: translate(-50%,-50%); animation: calm-reveal .2s ease both; }
.inspection-glaze { position: absolute; z-index: 4; inset: 0; pointer-events: none; background: linear-gradient(108deg,rgba(255,255,255,.08),transparent 32%,rgba(255,238,174,.12) 68%,transparent); }
.scan-light { z-index: 7; top: 50%; bottom: auto; width: 76rpx; height: 135%; border-radius: 50%; pointer-events: none; background: radial-gradient(ellipse,rgba(255,255,255,.9),rgba(255,225,135,.32) 34%,transparent 68%); filter: blur(7rpx); transform: translate(-50%,-50%) rotate(9deg); box-shadow: 0 0 45rpx rgba(255,232,157,.38); }
.inspection-feedback { display: flex; height: 84rpx; padding: 0 20rpx; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; color: #efd58b; background: rgba(240,205,112,.07); font-size: 20rpx; line-height: 1.45; text-align: center; }
.decision-note.is-repair-suggested { border-left: 4rpx solid #e1bd64; text-align: left; }
.decision-row { align-items: stretch; }
.decision-button { display: flex; min-height: 118rpx; margin: 12rpx 0 0; padding: 16rpx 12rpx; flex-direction: column; align-items: flex-start; justify-content: center; border: 1rpx solid rgba(240,205,112,.28); color: #ead9aa; background: rgba(240,205,112,.045); text-align: left; }
.decision-button text { font-size: 21rpx; }.decision-button small { margin-top: 7rpx; color: rgba(255,248,232,.42); font-size: 15rpx; line-height: 1.35; }
.decision-button.is-recommended { border-color: #e1bd64; background: linear-gradient(100deg,rgba(225,189,100,.16),rgba(225,189,100,.04)); box-shadow: 0 0 0 1rpx rgba(225,189,100,.12), 0 0 28rpx rgba(225,189,100,.12); animation: decision-pulse 1.8s ease-in-out infinite; }

.final-foil { display: block; height: 500rpx; border: 0; background: radial-gradient(circle,#ddcda9,#756047 68%,#34271d); }
.continuous-foil { position: absolute; top: 7%; left: 9%; width: 82%; height: 84%; overflow: hidden; border-radius: 8rpx 20rpx 10rpx 17rpx; background: #cc9833; box-shadow: 0 28rpx 60rpx rgba(0,0,0,.42), 0 0 0 9rpx rgba(255,242,191,.19); transition: filter .3s ease, clip-path .3s ease; }
.quality-perfect .continuous-foil { clip-path: polygon(1% 1%,99% 0,100% 99%,0 100%); }
.quality-minor .continuous-foil { clip-path: polygon(2% 1%,98% 0,100% 18%,98% 36%,100% 55%,98% 72%,100% 98%,73% 100%,51% 98%,27% 100%,1% 97%,2% 70%,0 45%,2% 22%); }
.quality-obvious .continuous-foil { clip-path: polygon(4% 2%,30% 0,47% 3%,66% 0,96% 4%,100% 22%,96% 39%,100% 58%,94% 76%,98% 96%,76% 100%,61% 96%,39% 100%,24% 95%,3% 98%,0 76%,4% 59%,0 38%); filter: saturate(.72) contrast(1.08); }
.finish-gloss { position: absolute; z-index: 5; inset: 0; pointer-events: none; background: linear-gradient(118deg,transparent 12%,rgba(255,246,200,.48) 34%,transparent 47%,rgba(255,228,142,.12) 72%,transparent); }
.wrinkle-veil { position: absolute; z-index: 6; inset: 0; pointer-events: none; background: repeating-linear-gradient(112deg,transparent 0 28rpx,rgba(74,37,10,.2) 30rpx,rgba(255,242,179,.18) 34rpx,transparent 40rpx), repeating-radial-gradient(ellipse at 20% 35%,transparent 0 28rpx,rgba(74,37,10,.15) 31rpx,transparent 39rpx); transition: opacity .12s linear; }
.foil-edge-mask { position: absolute; z-index: 7; inset: 0; pointer-events: none; box-shadow: inset 0 0 22rpx rgba(84,43,11,.34); }
.cut-guide-lines { position: absolute; z-index: 8; inset: 0; opacity: .34; pointer-events: none; background: linear-gradient(90deg,transparent 49.6%,rgba(83,44,13,.6) 50%,transparent 50.4%),linear-gradient(transparent 49.6%,rgba(83,44,13,.6) 50%,transparent 50.4%); }
.feather { z-index: 12; bottom: auto; padding: 8rpx 15rpx; border-radius: 50%; color: #f5ecd6; background: rgba(42,28,19,.72); text-shadow: 0 2rpx 7rpx rgba(0,0,0,.8); transition: left .08s linear, top .08s linear; transform: translate(-50%,-50%) rotate(-18deg); }
.smooth-trace { position: absolute; z-index: 10; bottom: 18rpx; left: 8%; max-width: 84%; height: 4rpx; border-radius: 4rpx; background: linear-gradient(90deg,rgba(255,255,255,.12),#fff1b8); box-shadow: 0 0 12rpx #fff1b8; }
.smooth-progress { height: 6rpx; margin-top: 20rpx; overflow: hidden; border-radius: 6rpx; background: rgba(255,255,255,.1); }.smooth-progress view { height: 100%; background: linear-gradient(90deg,#a96e20,#f4d77b); transition: width .12s linear; }
.warning-copy { color: #e69b7f; }.final-foil.has-new-damage { animation: damage-shiver .28s ease; }

@keyframes local-hammer { 0% { transform: scale(1); filter: brightness(1); } 35% { transform: scale(.9); filter: brightness(.72); box-shadow: inset 0 0 26rpx rgba(56,29,10,.55); } 72% { transform: scale(1.035); filter: brightness(1.28); } 100% { transform: scale(1); } }
@keyframes pack-turn { 0% { transform: rotate(0) scale(1); } 45% { transform: rotate(45deg) scale(.84); filter: brightness(1.24); } 100% { transform: rotate(90deg) scale(1); } }
@keyframes decision-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(225,189,100,.08); } 50% { box-shadow: 0 0 0 7rpx rgba(225,189,100,.07),0 0 30rpx rgba(225,189,100,.16); } }
@keyframes damage-shiver { 25% { transform: translateX(-3rpx); } 55% { transform: translateX(3rpx); } }

/* Beginner guard: every task remains interactive, but no precision gate can block completion. */
.beginner-guard { margin: -4rpx 0 22rpx; overflow: hidden; border: 1rpx solid rgba(126,190,139,.35); border-radius: 16rpx; background: linear-gradient(120deg,rgba(74,129,85,.16),rgba(240,205,112,.035)); }
.guard-copy { display: flex; padding: 16rpx 20rpx 13rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(255,255,255,.07); }
.guard-copy text { display: block; color: #b9ddb9; font-size: 21rpx; font-weight: 600; }
.guard-copy small { display: block; margin-top: 4rpx; color: rgba(235,247,232,.48); font-size: 16rpx; }
.guard-status { padding: 5rpx 10rpx; border-radius: 20rpx; color: #c9efc9; background: rgba(104,178,119,.18); font-size: 14rpx; letter-spacing: 1rpx; }
.guard-action { display: flex; min-height: 76rpx; padding: 10rpx 12rpx 10rpx 20rpx; align-items: center; gap: 12rpx; color: rgba(255,255,255,.52); font-size: 17rpx; }
.guard-action>view { flex: 1; }
.guard-action button { max-width: 68%; min-height: 54rpx; margin: 0; padding: 12rpx 18rpx; border: 1rpx solid rgba(185,221,185,.32); border-radius: 27rpx; color: #d5efd4; background: rgba(92,153,104,.18); font-size: 17rpx; line-height: 1.35; white-space: normal; }
.guard-action button[disabled] { opacity: .55; }

/* v4 interaction polish: fast, non-blocking feedback built on transform and opacity. */
.experience-shell { position: relative; overflow: hidden; }
.experience-shell>view:not(.ambient-gold):not(.moment-toast):not(.completion-overlay) { position: relative; z-index: 1; }
.ambient-gold { position: fixed; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
.ambient-piece { position: absolute; width: 22rpx; height: 34rpx; opacity: .12; background: linear-gradient(145deg,#fff0a3,#9f6117); transform: rotate(24deg); animation: ambient-drift 8s ease-in-out infinite; }
.ambient-piece.p1 { top: 18%; left: 7%; }.ambient-piece.p2 { top: 42%; right: 5%; width: 13rpx; height: 24rpx; animation-delay: -2.7s; }.ambient-piece.p3 { bottom: 14%; left: 16%; width: 17rpx; height: 28rpx; animation-delay: -5.2s; }
.topbar { position: sticky; z-index: 18; top: 0; padding: 16rpx 0 20rpx; background: linear-gradient(180deg,rgba(16,11,8,.98),rgba(16,11,8,.82) 72%,transparent); }
.workshop.scene-enter .heading,.workshop.scene-enter .beginner-guard,.workshop.scene-enter .action-demo,.workshop.scene-enter .stage-panel { animation: scene-rise .42s cubic-bezier(.2,.78,.3,1) both; }
.workshop.scene-enter .beginner-guard { animation-delay: .04s; }.workshop.scene-enter .action-demo,.workshop.scene-enter .stage-panel { animation-delay: .08s; }
.app-progress { position: sticky; z-index: 17; top: 78rpx; margin: 4rpx -4rpx 16rpx; padding: 12rpx 5rpx 15rpx; background: linear-gradient(180deg,rgba(16,11,8,.95),rgba(16,11,8,.78) 78%,transparent); }
.progress-copy { display: flex; align-items: center; justify-content: space-between; color: #e5c873; font-size: 17rpx; }
.progress-copy-main { display: flex; align-items: center; gap: 10rpx; }
.progress-copy small { color: rgba(255,255,255,.42); font-size: 15rpx; }
.progress-copy small.is-expired { color: #e5c873; }
.progress-exit { min-height: 0; margin: 0; padding: 6rpx 18rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 20rpx; color: rgba(249,240,218,.75); background: transparent; font-size: 17rpx; line-height: 1.6; }
.progress-track { height: 5rpx; margin-top: 9rpx; overflow: hidden; border-radius: 5rpx; background: rgba(255,255,255,.09); }
.progress-track view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#9a641c,#f4d77b); box-shadow: 0 0 14rpx rgba(244,215,123,.55); transition: width .32s cubic-bezier(.2,.8,.25,1); }
.task.current { background: linear-gradient(180deg,rgba(240,206,117,.09),transparent); }
.task.completed::after { margin-left: 7rpx; content: "✓"; color: #9bc89d; }
.stage-panel { transform: translateZ(0); }
.gold-button,.decision-button,.rotate-button,.guard-action button { transition: transform .14s ease, opacity .18s ease, box-shadow .2s ease; }
.gold-button:not([disabled]) { box-shadow: 0 12rpx 28rpx rgba(181,116,25,.22); }

.moment-toast { position: fixed; z-index: 50; left: 50%; max-width: 82%; padding: 14rpx 24rpx; border: 1rpx solid rgba(242,211,128,.32); border-radius: 40rpx; opacity: 0; color: #f7e7b3; background: rgba(35,23,14,.94); font-size: 19rpx; text-align: center; pointer-events: none; transform: translate(-50%,-18rpx) scale(.94); transition: opacity .2s ease, transform .28s cubic-bezier(.2,.85,.3,1); box-shadow: 0 14rpx 35rpx rgba(0,0,0,.35); }
.moment-toast.is-visible { opacity: 1; transform: translate(-50%,0) scale(1); }
.moment-toast.tone-green { border-color: rgba(154,205,160,.45); color: #d8f0d7; }.moment-toast.tone-red { border-color: rgba(222,133,105,.42); color: #f2baa8; }

.cut-bench.is-success .gold-strip { animation: material-glint .5s ease; }
.cut-bench.is-moving .cutter { box-shadow: 0 0 18rpx rgba(255,255,255,.9),0 0 34rpx rgba(244,215,123,.38); }
.gesture-meter { display: grid; margin-top: 16rpx; grid-template-columns: 105rpx 1fr 112rpx; align-items: center; gap: 12rpx; color: rgba(255,248,232,.48); font-size: 16rpx; }
.gesture-meter>view { height: 7rpx; overflow: hidden; border-radius: 7rpx; background: rgba(255,255,255,.1); }
.gesture-meter .gesture-meter-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#b36e25,#f0ce75,#a8d0a8); transition: width .1s linear; }
.gesture-meter small { color: rgba(255,248,232,.62); font-size: 15rpx; text-align: right; }
.cut-bench.is-full .gold-strip,.cut-bench.is-full .safe-zone,.cut-bench.is-full .cutter { opacity: .18; }
.cut-full-state { position: absolute; z-index: 9; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f6e5ae; background: rgba(24,15,9,.76); pointer-events: none; animation: calm-reveal .24s ease both; }
.cut-full-state text { font-family: serif; font-size: 48rpx; }.cut-full-state view { margin-top: 4rpx; font-size: 24rpx; }.cut-full-state small { margin-top: 7rpx; color: rgba(255,248,232,.5); font-size: 16rpx; }
.cut-burst { position: absolute; z-index: 7; inset: 0; display: grid; color: #fff0ba; font-size: 18rpx; place-items: center; pointer-events: none; }
.cut-burst text { padding: 8rpx 16rpx; border-radius: 28rpx; background: rgba(43,28,16,.82); animation: success-pop .5s ease both; }
.cut-burst>view { position: absolute; top: 48%; left: 50%; width: 8rpx; height: 18rpx; background: #f5d879; animation: gold-spark .5s ease-out both; }
.cut-burst>view:nth-child(2) { animation-delay: .04s; transform: rotate(90deg); }.cut-burst>view:nth-child(3) { animation-delay: .08s; transform: rotate(180deg); }.cut-burst>view:nth-child(4) { animation-delay: .12s; transform: rotate(270deg); }

.placement-target { display: flex; flex-direction: column; align-items: center; justify-content: center; animation: target-breathe 1.8s ease-in-out infinite; }
.placement-target text { font-size: 19rpx; }.placement-target small { margin-top: 5rpx; color: rgba(244,215,123,.52); font-size: 13rpx; }
.paper-pack.is-settling .placement-target { border-style: solid; color: #f2d781; background: rgba(240,206,117,.08); animation: settle-ring 1s ease-in-out infinite; }
.paper-pack.is-placement-ready .placement-target { border-style: solid; border-color: #a9d2aa; color: #d7efd5; background: rgba(104,166,112,.15); animation: none; box-shadow: 0 0 22rpx rgba(164,209,165,.18); }
.paper-pack.is-success .placement-target { animation: none; border-color: #a9d2aa; }
.placed-sheet { position: absolute; z-index: 3; top: 176rpx; left: calc(50% - 46rpx); width: 92rpx; height: 92rpx; background: linear-gradient(135deg,#9d6218,#f1cf6e,#a56819); box-shadow: 0 8rpx 18rpx rgba(0,0,0,.28); }
.placed-one { transform: rotate(-5deg); }.placed-two { transform: rotate(4deg) translate(2rpx,-3rpx); }.placed-three { transform: rotate(-1deg) translate(-2rpx,-6rpx); }
.loose-sheet { z-index: 5; will-change: transform; }
.magnet-ring { position: absolute; z-index: 8; top: 151rpx; left: calc(50% - 68rpx); width: 136rpx; height: 136rpx; border: 3rpx solid rgba(244,215,123,.8); border-radius: 50%; pointer-events: none; animation: magnet-lock .55s ease-out both; }
.paper-pack.is-full .paper-layer,.paper-pack.is-full .placement-target,.paper-pack.is-full .placed-sheet,.paper-pack.is-full .loose-sheet { opacity: .22; }
.pack-full-state { position: absolute; z-index: 10; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f6e5ae; background: rgba(24,15,9,.76); pointer-events: none; animation: calm-reveal .24s ease both; }
.pack-full-state text { font-family: serif; font-size: 48rpx; }.pack-full-state view { margin-top: 4rpx; font-size: 24rpx; }.pack-full-state small { margin-top: 7rpx; color: rgba(255,248,232,.5); font-size: 16rpx; }

.hammer-challenge { margin-bottom: 14rpx; padding: 18rpx 20rpx 16rpx; border: 1rpx solid rgba(240,206,117,.25); border-radius: 18rpx; background: linear-gradient(135deg,rgba(240,206,117,.09),rgba(255,255,255,.018)); box-shadow: inset 0 0 28rpx rgba(240,206,117,.035); }
.hammer-challenge-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.hammer-challenge-head>view:first-child { min-width: 0; }.hammer-challenge-head text { display: block; color: #f0d681; font-family: serif; font-size: 25rpx; font-weight: 600; }.hammer-challenge-head small { display: block; margin-top: 5rpx; color: rgba(255,248,232,.5); font-size: 16rpx; line-height: 1.45; }
.hammer-score { flex: 0 0 88rpx; padding-left: 16rpx; border-left: 1rpx solid rgba(240,206,117,.2); text-align: right; }.hammer-score text { color: #fff0a9; font-family: serif; font-size: 35rpx; line-height: 1; }.hammer-score small { margin-top: 4rpx; color: rgba(255,248,232,.42); font-size: 14rpx; white-space: nowrap; }
.rhythm-track { position: relative; height: 30rpx; margin-top: 16rpx; overflow: hidden; border-radius: 18rpx; background: linear-gradient(90deg,rgba(255,255,255,.025),rgba(240,206,117,.09),rgba(255,255,255,.025)); box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.06); }
.rhythm-track::before { position: absolute; top: 14rpx; right: 12rpx; left: 12rpx; height: 2rpx; content: ""; background: rgba(255,255,255,.12); }
.rhythm-target { position: absolute; z-index: 2; top: 3rpx; bottom: 3rpx; left: 44%; display: grid; width: 14%; border: 1rpx solid rgba(255,230,143,.72); border-radius: 14rpx; color: rgba(255,241,178,.86); background: rgba(222,170,52,.22); box-shadow: 0 0 18rpx rgba(244,205,96,.2); place-items: center; }.rhythm-target text { font-size: 12rpx; letter-spacing: 1rpx; }
.rhythm-cursor { position: absolute; z-index: 3; top: 7rpx; left: 2%; width: 16rpx; height: 16rpx; border: 2rpx solid rgba(255,248,209,.9); border-radius: 50%; background: #e5b84f; box-shadow: 0 0 16rpx #f2ce70; animation: hammer-beat 900ms linear infinite; }
.charge-row { display: grid; margin-top: 13rpx; align-items: center; grid-template-columns: 90rpx 1fr 80rpx; gap: 12rpx; }.charge-row>text { color: rgba(255,248,232,.55); font-size: 15rpx; }.charge-row>small { color: #dfc371; font-size: 14rpx; text-align: right; }
.charge-track { position: relative; height: 12rpx; overflow: hidden; border-radius: 8rpx; background: rgba(255,255,255,.08); }.charge-ideal { position: absolute; z-index: 2; top: 0; bottom: 0; left: 24%; width: 51%; border-right: 1rpx solid rgba(205,236,197,.72); border-left: 1rpx solid rgba(205,236,197,.72); background: rgba(134,190,131,.16); }.charge-fill { position: absolute; z-index: 1; top: 0; bottom: 0; left: 0; border-radius: 8rpx; background: linear-gradient(90deg,#9d671d,#f0ce75 65%,#d98753); box-shadow: 0 0 12rpx rgba(240,206,117,.3); transition: width .04s linear; }
.rhythm-coach { position: absolute; z-index: 12; top: 18rpx; left: 18rpx; display: flex; height: 54rpx; padding: 0 16rpx; align-items: center; gap: 7rpx; border: 1rpx solid rgba(240,206,117,.3); border-radius: 30rpx; color: #edd483; background: rgba(22,14,9,.82); font-size: 16rpx; pointer-events: none; animation: coach-in .28s ease both; }
.rhythm-coach>view { width: 9rpx; height: 9rpx; border-radius: 50%; background: #f0ce75; animation: rhythm-dot .54s ease-in-out 3; }.rhythm-coach>view:nth-child(2) { animation-delay: .14s; }.rhythm-coach>view:nth-child(3) { animation-delay: .28s; }
.combo-badge { position: absolute; z-index: 13; top: 19rpx; right: 19rpx; padding: 8rpx 13rpx; border-radius: 26rpx; color: rgba(255,255,255,.65); background: rgba(24,14,8,.8); font-size: 14rpx; letter-spacing: 1rpx; animation: success-pop .25s ease; }.combo-badge text { color: #f4d77b; font-size: 22rpx; }
.hammer-grade { position: absolute; z-index: 14; top: 84rpx; left: 50%; padding: 11rpx 24rpx; border: 1rpx solid rgba(255,246,198,.5); border-radius: 28rpx; color: #fff1b2; background: rgba(28,17,9,.9); font-family: serif; font-size: 24rpx; pointer-events: none; white-space: nowrap; animation: hammer-grade-pop .58s ease-out both; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.36); }.hammer-grade small { margin-left: 8rpx; color: #fff6cb; font-family: sans-serif; font-size: 15rpx; }.hammer-grade.grade-perfect { border-color: rgba(255,232,128,.9); background: linear-gradient(110deg,rgba(99,57,9,.94),rgba(41,24,10,.94)); box-shadow: 0 0 26rpx rgba(244,196,68,.48),0 8rpx 28rpx rgba(0,0,0,.35); }.hammer-grade.grade-good { color: #d9f0d3; border-color: rgba(174,215,164,.72); }.hammer-grade.grade-danger { color: #efb199; border-color: rgba(225,126,94,.62); }
.foil-zone.is-suggested::before { position: absolute; z-index: 7; inset: 10%; border: 2rpx solid rgba(255,245,190,.8); border-radius: 50%; content: ""; pointer-events: none; animation: suggested-pulse 1.15s ease-in-out infinite; }
.foil-zone.is-warning::before { position: absolute; z-index: 8; inset: 7%; border: 3rpx solid rgba(235,118,85,.92); border-radius: 50%; content: ""; pointer-events: none; animation: danger-pulse .38s ease-in-out infinite alternate; box-shadow: 0 0 24rpx rgba(222,93,62,.5); }
.foil-zone.is-pressed { z-index: 6; filter: brightness(1.22) saturate(1.08); transform: scale(.93); box-shadow: inset 0 0 20rpx rgba(255,244,183,.45); }
.impact-ring { position: absolute; z-index: 9; inset: 20%; border: 3rpx solid rgba(255,246,198,.9); border-radius: 50%; pointer-events: none; animation: impact-ring .34s ease-out both; }
.impact-ring.impact-light { inset: 28%; }.impact-ring.impact-heavy { inset: 12%; border-color: rgba(244,194,107,.92); }
.impact-sparks { position: absolute; z-index: 10; top: 50%; left: 50%; pointer-events: none; }.impact-sparks>view { position: absolute; width: 6rpx; height: 14rpx; border-radius: 5rpx; background: #fff0a0; box-shadow: 0 0 9rpx #f1c85c; animation: hammer-spark .38s ease-out both; }.impact-sparks>view:nth-child(1) { --spark-x: 34rpx; --spark-y: -32rpx; }.impact-sparks>view:nth-child(2) { --spark-x: -36rpx; --spark-y: -26rpx; animation-delay: .025s; }.impact-sparks>view:nth-child(3) { --spark-x: 30rpx; --spark-y: 32rpx; animation-delay: .045s; }.impact-sparks>view:nth-child(4) { --spark-x: -32rpx; --spark-y: 30rpx; animation-delay: .065s; }
.hammer-shadow { transition: transform .16s ease,filter .16s ease,border-color .16s ease; }.hammer-shadow.is-striking { border-color: rgba(255,230,139,.72); filter: brightness(1.25); transform: translate(-12rpx,12rpx) rotate(-12deg) scale(.9); }
.hammer-input-readout { display: grid; margin-top: 4rpx; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.hammer-input-readout>view { display: flex; min-height: 66rpx; padding: 10rpx 16rpx; align-items: center; justify-content: space-between; border: 1rpx solid rgba(255,255,255,.08); border-radius: 12rpx; background: rgba(255,255,255,.025); }
.hammer-input-readout small { color: rgba(255,248,232,.4); font-size: 15rpx; }.hammer-input-readout text { font-size: 19rpx; }
.hammer-input-readout .tone-perfect { color: #ffe88e; text-shadow: 0 0 12rpx rgba(255,222,102,.42); }.hammer-input-readout .tone-good { color: #c9e5c6; }.hammer-input-readout .tone-warn { color: #e8c780; }.hammer-input-readout .tone-neutral { color: rgba(255,248,232,.55); }
.hammer-workbench.is-ready .hammer-foil,.hammer-workbench.is-ready .pack-paper,.hammer-workbench.is-ready .hammer-shadow { opacity: .2; }
.hammer-ready-state { position: absolute; z-index: 15; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f6e5ae; background: rgba(20,13,8,.7); pointer-events: none; animation: success-pop .35s ease both; }
.hammer-ready-state text { display: grid; width: 72rpx; height: 72rpx; margin-bottom: 14rpx; border: 2rpx solid #b9ddb9; border-radius: 50%; color: #cce7c9; font-size: 36rpx; place-items: center; }.hammer-ready-state view { font-size: 25rpx; }.hammer-ready-state small { margin-top: 7rpx; color: rgba(255,248,232,.52); font-size: 16rpx; }

.discovery-badge { position: absolute; z-index: 10; top: 18rpx; right: 18rpx; padding: 8rpx 14rpx; border-radius: 25rpx; color: #f4e3ae; background: rgba(46,31,19,.72); font-size: 16rpx; pointer-events: none; }
.inspection-surface.is-ready .discovery-badge { color: #d3ecd1; background: rgba(52,104,62,.78); }
.scan-light { will-change: left,top; transition: left .035s linear,top .035s linear; }
.finish-percent { position: absolute; z-index: 13; right: 22rpx; bottom: 20rpx; color: rgba(255,247,214,.78); font-family: serif; font-size: 25rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.65); }
.finish-percent small { display: block; margin-top: 3rpx; color: #d7efd5; font-family: sans-serif; font-size: 14rpx; text-align: right; }
.final-foil.is-holding .continuous-foil { animation: finish-hold .42s ease-in-out infinite alternate; }
.final-foil.is-ready .continuous-foil { box-shadow: 0 28rpx 60rpx rgba(0,0,0,.42),0 0 0 9rpx rgba(218,239,205,.22),0 0 42rpx rgba(244,215,123,.2); }

.completion-overlay { overflow: hidden; animation: celebration-in .4s ease both; }
.completion-overlay small { margin-top: 13rpx; color: rgba(255,247,221,.52); font-family: sans-serif; font-size: 18rpx; }
.celebration-particles { position: absolute; inset: 0; pointer-events: none; }
.celebration-particles view { position: absolute; top: -8%; left: 50%; width: 13rpx; height: 25rpx; background: linear-gradient(145deg,#fff0a0,#b9781f); animation: confetti-fall 1.25s ease-in infinite; }
.celebration-particles .cp-1 { left: 7%; animation-delay: -.1s; }.celebration-particles .cp-2 { left: 15%; animation-delay: -.7s; }.celebration-particles .cp-3 { left: 24%; animation-delay: -.35s; }.celebration-particles .cp-4 { left: 33%; animation-delay: -.9s; }.celebration-particles .cp-5 { left: 42%; animation-delay: -.5s; }.celebration-particles .cp-6 { left: 51%; animation-delay: -.15s; }.celebration-particles .cp-7 { left: 59%; animation-delay: -.78s; }.celebration-particles .cp-8 { left: 67%; animation-delay: -.42s; }.celebration-particles .cp-9 { left: 74%; animation-delay: -.98s; }.celebration-particles .cp-10 { left: 82%; animation-delay: -.28s; }.celebration-particles .cp-11 { left: 90%; animation-delay: -.62s; }.celebration-particles .cp-12 { left: 96%; animation-delay: -.05s; }

/* v5 deep craft scenes: tools and material response lead each task. */
.cut-bench { height: 310rpx; background: linear-gradient(90deg,rgba(255,255,255,.018) 1rpx,transparent 1rpx),repeating-linear-gradient(90deg,#302115 0 36rpx,#281a11 36rpx 72rpx); background-size: 18rpx 100%,auto; box-shadow: inset 0 0 55rpx rgba(0,0,0,.46); }
.bench-caption { position: absolute; top: 18rpx; right: 20rpx; left: 20rpx; display: flex; align-items: center; justify-content: space-between; color: #e5c777; }.bench-caption text { font-family: serif; font-size: 21rpx; }.bench-caption small { color: rgba(255,248,232,.36); font-size: 14rpx; }
.measure-ruler { position: absolute; top: 67rpx; right: 34rpx; left: 34rpx; display: flex; height: 28rpx; align-items: flex-start; justify-content: space-between; border-top: 1rpx solid rgba(233,218,183,.38); }.measure-ruler view { width: 1rpx; height: 12rpx; background: rgba(233,218,183,.42); }.measure-ruler view:nth-child(odd) { height: 20rpx; }
.cut-bench .gold-strip { top: 126rpx; height: 78rpx; overflow: hidden; border-radius: 2rpx 12rpx 7rpx 3rpx; background: linear-gradient(102deg,#8f5711,#d49b32 19%,#f8e18b 47%,#c78520 72%,#8d5514); box-shadow: 0 12rpx 32rpx rgba(0,0,0,.45),inset 0 0 12rpx rgba(255,241,174,.28); }
.gold-grain { position: absolute; inset: 0; opacity: .45; background: repeating-linear-gradient(5deg,rgba(80,40,8,.18) 0 1rpx,transparent 1rpx 9rpx),linear-gradient(115deg,transparent 35%,rgba(255,255,255,.34) 46%,transparent 58%); }.cut-edge { position: absolute; top: 0; right: 0; width: 12%; height: 100%; background: repeating-linear-gradient(90deg,transparent 0 4rpx,rgba(80,38,8,.22) 4rpx 5rpx); }
.cut-bench .safe-zone { z-index: 1; top: 103rpx; bottom: 54rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; border-color: rgba(255,240,184,.72); background: rgba(255,229,136,.07); }.safe-zone text { padding: 4rpx 8rpx; color: #f2d884; background: rgba(41,26,14,.8); font-size: 14rpx; }.safe-zone small { margin-top: 3rpx; color: rgba(255,248,232,.4); font-size: 11rpx; }
.cut-bench .cutter { top: 88rpx; width: 48rpx; height: 166rpx; background: transparent; box-shadow: none; }.cutter-handle { position: absolute; top: 0; left: 50%; width: 34rpx; height: 70rpx; border-radius: 7rpx 7rpx 3rpx 3rpx; background: linear-gradient(90deg,#3b2415,#7c4b27,#2d1c12); box-shadow: 0 8rpx 12rpx rgba(0,0,0,.38); transform: translateX(-50%); }.cutter-blade { position: absolute; top: 55rpx; left: 50%; width: 8rpx; height: 108rpx; background: linear-gradient(90deg,#988e7b,#fff8dc,#aaa08b); box-shadow: 0 0 10rpx rgba(255,255,255,.62); transform: translateX(-50%); }
.cut-local-result { position: absolute; z-index: 6; top: 210rpx; left: 50%; display: flex; padding: 7rpx 14rpx; align-items: center; gap: 8rpx; border-radius: 26rpx; color: #efb49e; background: rgba(47,24,16,.9); font-size: 15rpx; pointer-events: none; transform: translateX(-50%); animation: calm-reveal .18s ease both; }.cut-local-result>view { width: 12rpx; height: 12rpx; border: 1rpx solid #df866a; transform: rotate(45deg); }.cut-local-result.result-frayed::after { position: absolute; top: -15rpx; left: 50%; width: 44rpx; height: 18rpx; content: ""; border-top: 3rpx dotted #df866a; transform: translateX(-50%) rotate(-8deg); }
.piece-tray { display: grid; margin-top: 14rpx; padding: 13rpx 16rpx; align-items: center; grid-template-columns: 1fr 62rpx 62rpx 62rpx; gap: 10rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 14rpx; background: rgba(9,6,4,.26); }.tray-copy text,.tray-copy small { display: block; }.tray-copy text { color: #d9bd70; font-size: 17rpx; }.tray-copy small { margin-top: 3rpx; color: rgba(255,248,232,.34); font-size: 12rpx; }.tray-slot { display: grid; height: 48rpx; border: 1rpx solid rgba(238,209,132,.18); border-radius: 7rpx; background: rgba(0,0,0,.16); place-items: center; }.tray-slot view { width: 38rpx; height: 28rpx; opacity: 0; background: linear-gradient(135deg,#a46515,#f0cf71,#9c5f13); transform: rotate(-4deg) scale(.65); transition: opacity .22s ease,transform .3s ease; }.tray-slot.has-piece view { opacity: 1; transform: rotate(-4deg) scale(1); box-shadow: 0 4rpx 9rpx rgba(0,0,0,.35); }
.cut-bench.cut-result-frayed .gold-strip { filter: saturate(.76); }.cut-bench.cut-result-frayed .cut-edge { width: 22%; clip-path: polygon(0 0,100% 8%,55% 21%,100% 38%,62% 52%,100% 71%,52% 85%,100% 100%,0 100%); background: rgba(90,42,12,.3); }

.pack-status-bar { position: absolute; z-index: 9; top: 16rpx; right: 18rpx; left: 18rpx; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }.pack-status-bar text,.pack-status-bar small { display: block; }.pack-status-bar text { color: #e4c675; font-size: 18rpx; }.pack-status-bar small { margin-top: 3rpx; color: rgba(255,248,232,.4); font-size: 13rpx; }.layer-depth { text-align: right; }.layer-depth text { display: inline; font-family: serif; font-size: 30rpx; }.layer-depth small { display: inline; margin-left: 4rpx; }
.paper-fibre { position: absolute; inset: 0; opacity: .34; background: repeating-linear-gradient(8deg,rgba(255,255,255,.06) 0 1rpx,transparent 1rpx 11rpx),repeating-linear-gradient(96deg,rgba(0,0,0,.1) 0 1rpx,transparent 1rpx 17rpx); }
.tweezer-tool { position: absolute; z-index: 7; top: 176rpx; left: calc(50% - 46rpx); width: 92rpx; height: 92rpx; pointer-events: none; transform-origin: 50% -30rpx; will-change: transform; }.tweezer-arm { position: absolute; z-index: 2; bottom: 58rpx; width: 9rpx; height: 128rpx; border-radius: 7rpx; background: linear-gradient(90deg,#806f52,#d3c4a3,#79694f); box-shadow: 0 5rpx 10rpx rgba(0,0,0,.32); }.arm-left { left: 26rpx; transform: rotate(-7deg); }.arm-right { right: 26rpx; transform: rotate(7deg); }.tweezer-tool .loose-sheet { position: absolute; z-index: 3; top: 0; left: 0; width: 92rpx; height: 92rpx; border-radius: 2rpx 8rpx 4rpx 6rpx; transform: translateX(var(--drift)); transition: transform .08s linear; }.tweezer-tool.is-drifting .loose-sheet { animation: foil-drift .18s ease-in-out infinite alternate; }.foil-corner { position: absolute; right: 0; bottom: 0; width: 24rpx; height: 24rpx; background: linear-gradient(135deg,transparent 48%,rgba(98,52,12,.35) 51%); }
.paper-pack.is-full .tweezer-tool { opacity: .16; }
.paper-pack.is-rejected .placement-target { border-color: rgba(227,125,92,.9); color: #efb098; background: rgba(177,71,45,.13); animation: none; box-shadow: 0 0 22rpx rgba(205,91,61,.18); }.paper-pack.is-rejected .loose-sheet { filter: saturate(.66) brightness(.84); }

.workbench-plaque { position: absolute; z-index: 10; bottom: 16rpx; left: 18rpx; padding: 8rpx 12rpx; border-left: 3rpx solid rgba(240,206,117,.52); color: rgba(255,248,232,.62); background: rgba(20,12,7,.62); pointer-events: none; }.workbench-plaque text,.workbench-plaque small { display: block; }.workbench-plaque text { color: #e5ca79; font-size: 15rpx; }.workbench-plaque small { margin-top: 2rpx; font-size: 12rpx; }
.hammer-foil { gap: 0; }.foil-zone { border: 0; }.foil-zone::after { opacity: .18; border-color: rgba(86,45,10,.08); }.foil-zone:not(.is-warning):not(.is-suggested) { box-shadow: none; }
.hammer-shadow.hammer-tool { right: auto; z-index: 12; width: 92rpx; height: 182rpx; border: 0; border-radius: 0; background: transparent; pointer-events: none; transform: translate(-50%,-50%) rotate(-28deg); transform-origin: 50% 72%; transition: left .18s cubic-bezier(.2,.8,.3,1),top .18s cubic-bezier(.2,.8,.3,1),transform .13s ease,filter .13s ease; }.hammer-handle { position: absolute; top: 5rpx; left: 41rpx; width: 14rpx; height: 128rpx; border-radius: 8rpx; background: linear-gradient(90deg,#3a2111,#a66a32 45%,#3c2110); box-shadow: 4rpx 6rpx 10rpx rgba(0,0,0,.38); }.hammer-head { position: absolute; right: 4rpx; bottom: 6rpx; display: grid; width: 82rpx; height: 58rpx; border-radius: 18rpx 9rpx 16rpx 8rpx; color: rgba(246,222,155,.78); background: linear-gradient(135deg,#77684e,#b6a57f 42%,#514630); box-shadow: 0 9rpx 18rpx rgba(0,0,0,.46),inset 0 0 0 2rpx rgba(255,244,207,.16); place-items: center; }.hammer-head text { font-family: serif; font-size: 17rpx; }.hammer-shadow.hammer-tool.is-striking { border: 0; filter: brightness(1.25); transform: translate(-50%,-50%) rotate(-16deg) scale(.92); }

.material-memory { display: grid; margin: -7rpx 0 17rpx; grid-template-columns: 190rpx 1fr; gap: 10rpx; }.material-memory>view { min-width: 0; padding: 13rpx 15rpx; border: 1rpx solid var(--exhibit-memory-accent-line); border-radius: 13rpx; background: var(--exhibit-memory-accent-bg); }.material-memory small,.material-memory text { display: block; }.material-memory small { color: var(--exhibit-text-soft-42); font-size: 12rpx; letter-spacing: 1rpx; }.material-memory text { margin-top: 4rpx; overflow: hidden; color: var(--exhibit-memory-accent); font-size: 15rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.inspection-surface { touch-action: none; box-shadow: inset 0 0 80rpx rgba(0,0,0,.42); }
.light-instruction { position: absolute; z-index: 12; top: 17rpx; left: 18rpx; padding-left: 12rpx; border-left: 3rpx solid rgba(255,231,157,.5); pointer-events: none; }.light-instruction text,.light-instruction small { display: block; }.light-instruction text { color: #f1d889; font-size: 16rpx; }.light-instruction small { margin-top: 3rpx; color: rgba(255,248,232,.4); font-size: 12rpx; }
.inspection-patch { transition: filter .18s ease,box-shadow .2s ease; }.inspection-patch.is-candidate { z-index: 5; filter: brightness(1.22) saturate(1.08); box-shadow: inset 0 0 20rpx rgba(255,246,203,.35); }.inspection-surface .inspection-glaze { background: linear-gradient(108deg,rgba(255,255,255,.035),transparent 32%,rgba(255,238,174,.06) 68%,transparent); }
.inspection-surface .scan-light { z-index: 8; top: auto; bottom: auto; width: 170rpx; height: 170rpx; border: 1rpx solid rgba(255,244,198,.2); border-radius: 50%; opacity: .32; background: radial-gradient(circle,rgba(255,255,255,.8) 0,rgba(255,238,174,.28) 24%,rgba(255,222,131,.08) 50%,transparent 72%); filter: blur(5rpx); pointer-events: none; transform: translate(-50%,-50%); transition: opacity .16s ease; }.inspection-surface.is-scanning .scan-light { opacity: .88; }
.inspection-lamp { position: absolute; z-index: 13; width: 78rpx; height: 112rpx; pointer-events: none; transform: translate(-50%,-16%) rotate(-22deg); transition: left .06s linear,top .06s linear; }.lamp-body { position: absolute; right: 2rpx; bottom: 0; width: 30rpx; height: 72rpx; border-radius: 7rpx 7rpx 13rpx 13rpx; background: linear-gradient(90deg,#34291f,#8b7960,#30261d); box-shadow: 0 7rpx 15rpx rgba(0,0,0,.4); }.lamp-beam { position: absolute; top: -23rpx; left: -20rpx; width: 72rpx; height: 66rpx; opacity: .45; border-radius: 50%; background: radial-gradient(circle,rgba(255,249,219,.72),rgba(255,226,132,.12) 48%,transparent 70%); }.inspection-surface.is-scanning .lamp-beam { opacity: .95; }
.dwell-ring { position: absolute; top: -22rpx; left: -30rpx; width: 90rpx; height: 7rpx; overflow: hidden; border-radius: 7rpx; background: rgba(25,16,10,.62); box-shadow: 0 0 0 1rpx rgba(255,239,177,.28); transform: rotate(22deg); }.dwell-ring view { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#c9912e,#fff0a2); box-shadow: 0 0 9rpx rgba(255,226,124,.5); transition: width .04s linear; }
.inspection-surface.is-ready .inspection-lamp,.inspection-surface.is-ready .scan-light,.inspection-surface.is-ready .light-instruction { opacity: .18; }

.finish-tool-label { position: absolute; z-index: 14; top: 18rpx; left: 20rpx; padding: 8rpx 12rpx; border-left: 3rpx solid rgba(255,237,170,.54); color: #f1d987; background: rgba(45,31,21,.54); pointer-events: none; }.finish-tool-label text,.finish-tool-label small { display: block; }.finish-tool-label text { font-size: 16rpx; }.finish-tool-label small { margin-top: 2rpx; color: rgba(255,248,232,.42); font-size: 12rpx; }
.finish-patch .cell-wrinkle { position: absolute; z-index: 4; inset: 0; opacity: .7; background: repeating-linear-gradient(112deg,transparent 0 15rpx,rgba(67,34,8,.2) 17rpx,rgba(255,242,179,.14) 20rpx,transparent 24rpx); transition: opacity .28s ease,transform .3s ease; }.finish-patch.is-smoothed .cell-wrinkle { opacity: 0; transform: scaleX(1.12); }.finish-patch.is-smoothed .zone-sheen { filter: brightness(1.16); }
.finish-trail { position: absolute; z-index: 11; inset: 0; pointer-events: none; }.finish-trail view { position: absolute; width: 42rpx; height: 10rpx; border-radius: 50%; opacity: .52; background: rgba(255,245,198,.74); filter: blur(3rpx); transform: translate(-50%,-50%) rotate(-14deg); animation: brush-trace .62s ease-out both; }
.final-foil .feather { width: 94rpx; height: 118rpx; padding: 0; border-radius: 0; background: transparent; text-shadow: none; pointer-events: none; transform: translate(-50%,-50%) rotate(-24deg); transform-origin: 50% 90%; }.feather-shaft { position: absolute; top: 8rpx; left: 47rpx; width: 5rpx; height: 108rpx; border-radius: 5rpx; background: linear-gradient(#fff6d5,#b99e73); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.35); }.feather-vane { position: absolute; left: 13rpx; width: 70rpx; height: 30rpx; border-radius: 65% 20% 65% 20%; background: linear-gradient(90deg,rgba(255,250,224,.86),rgba(210,194,160,.4)); transform-origin: 50% 50%; }.vane-a { top: 12rpx; transform: rotate(-5deg); }.vane-b { top: 31rpx; transform: rotate(5deg) scale(.94); }.vane-c { top: 51rpx; transform: rotate(-3deg) scale(.82); }.vane-d { top: 70rpx; transform: rotate(7deg) scale(.67); }
.final-foil .smooth-trace { height: 5rpx; overflow: visible; background: rgba(255,244,194,.32); }.smooth-trace>view { position: absolute; right: -5rpx; top: -5rpx; width: 15rpx; height: 15rpx; border-radius: 50%; background: #fff0a0; box-shadow: 0 0 14rpx #f2ce70; }
.finished-leaf-seal { position: absolute; z-index: 16; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f5e5af; background: radial-gradient(circle,rgba(48,29,11,.48),rgba(18,12,8,.82)); pointer-events: none; animation: leaf-reveal .48s ease both; }.finished-leaf-seal>text { display: grid; width: 76rpx; height: 76rpx; margin-bottom: 13rpx; border: 2rpx solid #f0d37d; border-radius: 50%; font-family: serif; font-size: 38rpx; place-items: center; }.finished-leaf-seal>view { font-family: serif; font-size: 27rpx; }.finished-leaf-seal small { margin-top: 7rpx; color: rgba(255,248,232,.5); font-size: 14rpx; }

@keyframes scene-rise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes ambient-drift { 0%,100% { opacity: .07; transform: translate3d(0,0,0) rotate(18deg); } 50% { opacity: .18; transform: translate3d(12rpx,-35rpx,0) rotate(52deg); } }
@keyframes material-glint { 0%,100% { transform: scaleX(1); } 45% { transform: scaleX(1.025); box-shadow: 0 0 35rpx rgba(255,228,136,.55); } }
@keyframes settle-ring { 0%,100% { border-color: rgba(240,206,117,.55); box-shadow: 0 0 0 0 rgba(240,206,117,0); } 50% { border-color: rgba(240,206,117,.9); box-shadow: 0 0 18rpx rgba(240,206,117,.12); } }
@keyframes finish-hold { from { filter: brightness(1); } to { filter: brightness(1.1); } }
@keyframes danger-pulse { from { opacity: .55; transform: scale(.86); } to { opacity: 1; transform: scale(1); } }
@keyframes calm-reveal { from { opacity: 0; } to { opacity: 1; } }
@keyframes success-pop { from { opacity: 0; transform: scale(.72); } 70% { transform: scale(1.08); } to { opacity: 1; transform: scale(1); } }
@keyframes gold-spark { from { opacity: 1; transform: translate(0,0) rotate(25deg); } to { opacity: 0; transform: translate(70rpx,-70rpx) rotate(110deg); } }
@keyframes target-breathe { 50% { border-color: rgba(244,215,123,.9); box-shadow: 0 0 24rpx rgba(244,215,123,.16); } }
@keyframes target-lock { 40% { transform: translateX(-50%) scale(.86); border-color: #fff0a9; } 100% { transform: translateX(-50%) scale(1); } }
@keyframes magnet-lock { from { opacity: .9; transform: scale(1.35); } to { opacity: 0; transform: scale(.72); } }
@keyframes coach-in { from { opacity: 0; transform: translateY(-10rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes rhythm-dot { 50% { transform: scale(1.8); box-shadow: 0 0 13rpx #f0ce75; } }
@keyframes foil-drift { from { transform: translateX(calc(0px - var(--drift))) rotate(-2deg); } to { transform: translateX(var(--drift)) rotate(2deg); } }
@keyframes brush-trace { from { opacity: .7; transform: translate(-50%,-50%) rotate(-14deg) scaleX(.5); } to { opacity: 0; transform: translate(-50%,-50%) rotate(-14deg) scaleX(1.8); } }
@keyframes leaf-reveal { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
@keyframes hammer-beat { from { left: 2%; } to { left: calc(98% - 16rpx); } }
@keyframes hammer-grade-pop { 0% { opacity: 0; transform: translate(-50%,10rpx) scale(.78); } 35% { opacity: 1; transform: translate(-50%,0) scale(1.08); } 100% { opacity: 0; transform: translate(-50%,-12rpx) scale(1); } }
@keyframes hammer-spark { from { opacity: 1; transform: translate(-3rpx,-7rpx) scale(1); } to { opacity: 0; transform: translate(var(--spark-x),var(--spark-y)) scale(.25); } }
@keyframes suggested-pulse { 0%,100% { opacity: .35; transform: scale(.72); } 55% { opacity: .9; transform: scale(1); } }
@keyframes impact-ring { from { opacity: 1; transform: scale(.3); } to { opacity: 0; transform: scale(2); } }
@keyframes celebration-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes confetti-fall { from { opacity: 0; transform: translate3d(0,-10vh,0) rotate(0); } 12% { opacity: 1; } to { opacity: .1; transform: translate3d(28rpx,115vh,0) rotate(420deg); } }
@keyframes ready-button { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3rpx); box-shadow: 0 19rpx 40rpx rgba(220,166,57,.38),0 0 0 1rpx rgba(255,236,167,.35); } }

@media (prefers-reduced-motion: reduce) {
  .ambient-piece,.placement-target,.foil-zone.is-suggested::before,.rhythm-coach>view,.rhythm-cursor,.impact-sparks>view,.tweezer-tool.is-drifting .loose-sheet,.finish-trail view,.finished-leaf-seal,.celebration-particles view,.gold-button.is-ready,.decision-button.is-recommended,.paper-pack.is-settling .placement-target,.foil-zone.is-warning::before,.final-foil.is-holding .continuous-foil { animation: none; }
  .workshop.scene-enter .heading,.workshop.scene-enter .beginner-guard,.workshop.scene-enter .action-demo,.workshop.scene-enter .stage-panel { animation-duration: .01s; }
}

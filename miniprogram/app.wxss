page {
  --gold: #b88a2a;
  --deep-brown: #3b2a1f;
  --warm-white: #fffaf0;
  --muted-gold: #e8d7ad;
  --page-gutter: 32rpx;
  --card-radius: 20rpx;
  --paper: #f6eedf;
  --ink-soft: #735f50;
  --exhibit-line: #d8b66a;
  --paper-shadow: 0 14rpx 32rpx rgba(59, 42, 31, .10);
  box-sizing: border-box;
  min-height: 100%;
  padding: var(--page-gutter);
  background: var(--warm-white);
  color: var(--deep-brown);
  font-size: 28rpx;
  line-height: 1.6;
}

text,
button,
input,
textarea {
  font-size: 28rpx;
}

button:focus,
.focusable:focus {
  outline: 4rpx solid var(--gold);
  outline-offset: 4rpx;
}

button:active,
.focusable:active {
  background-color: var(--muted-gold);
  opacity: 0.85;
  transform: scale(0.98);
}

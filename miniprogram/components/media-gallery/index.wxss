.category-page { min-height: 100vh; color: #f9f0da; background: radial-gradient(circle at 92% 0, #52351c, #20140d 36%, #100b08 80%); }.category-topbar { display: flex; padding: calc(30rpx + env(safe-area-inset-top)) 30rpx 20rpx; align-items: center; justify-content: space-between; }.eyebrow { color: #d7ad57; font-size: 18rpx; letter-spacing: 4rpx; }.brand { margin-top: 7rpx; font-family: serif; font-size: 31rpx; }.back-button { min-width: 134rpx; margin: 0; padding: 9rpx 15rpx; border: 1rpx solid rgba(244,215,123,.3); border-radius: 0; color: #efcc73; background: rgba(244,215,123,.05); font-size: 20rpx; }.category-hero { position: relative; margin: 18rpx 30rpx 0; padding: 48rpx 32rpx 44rpx; overflow: hidden; border: 1rpx solid rgba(244,215,123,.2); background: linear-gradient(125deg, rgba(106,71,33,.5), rgba(22,14,10,.88)); }.hero-shape { position: absolute; border: 1rpx solid rgba(244,215,123,.16); transform: rotate(28deg); }.hero-shape.one { top: -120rpx; right: -80rpx; width: 310rpx; height: 210rpx; }.hero-shape.two { right: 74rpx; bottom: -162rpx; width: 360rpx; height: 240rpx; transform: rotate(-18deg); }.hero-title { position: relative; margin-top: 19rpx; font-family: serif; font-size: 47rpx; font-weight: 700; line-height: 1.2; }.hero-copy { position: relative; margin-top: 18rpx; color: rgba(255,248,232,.65); font-size: 22rpx; line-height: 1.75; }
.video-content { padding: 45rpx 30rpx calc(54rpx + env(safe-area-inset-bottom)); }.empty-video-state { display: flex; min-height: 176rpx; padding: 25rpx; flex-direction: column; justify-content: center; border: 1rpx dashed rgba(244,215,123,.25); color: rgba(255,248,232,.58); background: rgba(255,255,255,.025); }.empty-video-state text { color: #e9ca78; font-family: serif; font-size: 30rpx; }.empty-video-state small { margin-top: 10rpx; color: rgba(255,248,232,.4); font-size: 19rpx; }.video-card + .video-card { margin-top: 24rpx; }.video-card { overflow: hidden; border: 1rpx solid rgba(244,215,123,.16); background: rgba(255,255,255,.04); box-shadow: 0 20rpx 48rpx rgba(0,0,0,.22); }.video-cover { position: relative; height: 310rpx; overflow: hidden; background: linear-gradient(135deg, #6a461d, #20140d); }.video-cover-action:active { opacity: .9; }.video-cover image { width: 100%; height: 100%; }.cover-placeholder { position: relative; width: 100%; height: 100%; overflow: hidden; background: linear-gradient(135deg, #725020, #24150a 55%, #100b08); }.cover-placeholder text { position: absolute; top: 50%; left: 50%; color: rgba(255,237,172,.78); font-family: serif; font-size: 92rpx; transform: translate(-50%, -50%); }.cover-placeholder view { position: absolute; border: 1rpx solid rgba(255,233,151,.22); transform: rotate(28deg); }.cover-placeholder view:nth-of-type(1) { top: -50rpx; right: 22rpx; width: 230rpx; height: 145rpx; }.cover-placeholder view:nth-of-type(2) { bottom: -70rpx; left: 52rpx; width: 290rpx; height: 170rpx; transform: rotate(-17deg); }.cover-gradient { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(9,6,4,.62), transparent 64%); }.duration { position: absolute; right: 18rpx; bottom: 17rpx; padding: 6rpx 11rpx; color: #fff3c9; background: rgba(0,0,0,.56); font-size: 19rpx; }.play-mark { position: absolute; top: 50%; left: 50%; display: grid; width: 80rpx; height: 80rpx; border: 1rpx solid rgba(255,240,180,.72); border-radius: 50%; color: #fff0a8; background: rgba(24,15,8,.38); font-size: 31rpx; place-items: center; transform: translate(-50%, -50%); }.video-body { padding: 27rpx 25rpx 25rpx; }.video-title { font-family: serif; font-size: 31rpx; font-weight: 700; }.video-description { margin-top: 12rpx; color: rgba(255,248,232,.65); font-size: 22rpx; line-height: 1.7; }.video-notice { margin-top: 13rpx; color: rgba(255,248,232,.4); font-size: 18rpx; line-height: 1.6; }
.player-sheet { position: fixed; z-index: 20; inset: 0; display: flex; padding: 30rpx; box-sizing: border-box; align-items: center; justify-content: center; }.player-mask { position: absolute; inset: 0; background: rgba(0,0,0,.72); }.player-panel { position: relative; width: 100%; max-width: 680rpx; padding: 25rpx; box-sizing: border-box; background: #17100c; box-shadow: 0 16rpx 48rpx rgba(0,0,0,.38); }.player-heading { display: flex; margin-bottom: 18rpx; align-items: center; justify-content: space-between; color: #f5df97; font-family: serif; font-size: 28rpx; }.player-heading button { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; color: #f5df97; background: rgba(255,255,255,.08); font-size: 39rpx; }.video-player { width: 100%; height: 390rpx; background: #000; }
@media (max-width: 360px) { .hero-title { font-size: 43rpx; }.back-button { min-width: 116rpx; padding-right: 10rpx; padding-left: 10rpx; }.video-body { padding-right: 20rpx; padding-left: 20rpx; } }

.tab-bar { display: flex; height: 100rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid rgba(255,255,255,.08); background: #150d08; }
.tab-bar-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; color: rgba(249,240,218,.5); }
.tab-bar-item text { font-size: 22rpx; }
.tab-icon { width: 42rpx; height: 42rpx; opacity: .55; }
.tab-bar-item.is-active { color: #f4d77b; }
.tab-bar-item.is-active text { font-weight: 700; }
.tab-bar-item.is-active .tab-icon { opacity: 1; }
